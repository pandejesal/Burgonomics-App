# ─── DEVELOPMENT ENVIRONMENT CONFIGURATION ───────────────────────
# Fast iteration, permissive, debugging enabled, localhost bounds.

# App General
APP_NAME=BURGONOMICS-Dev
APP_PORT=3000
APP_GLOBAL_PREFIX=api/v1
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Logging & Debugging
LOG_LEVEL=debug
SENTRY_DSN=
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# Databases & Cache (Local Docker Compose)
DATABASE_URL=postgresql://burgonomics:burgonomics@localhost:5432/burgonomics?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TLS=false

# Cache TTLs (Shorter for development testing)
CACHE_DEFAULT_TTL_SECONDS=60
CACHE_MENU_TTL_SECONDS=30

# Background Worker (BullMQ)
BULLMQ_PREFIX=burg_dev
BULLMQ_DEFAULT_ATTEMPTS=3
BULLMQ_DEFAULT_BACKOFF_MS=1000

# Security & Sessions
JWT_ACCESS_SECRET=dev_only_super_secure_access_secret_key_12345
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev_only_super_secure_refresh_secret_key_12345
JWT_REFRESH_TTL=7d
JWT_ISSUER=burgonomics.dev
JWT_AUDIENCE=burgonomics-app

# Rate Limiting (Generous for local testing)
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=1000

# Telemetry / Observability
METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_SERVICE_NAME=burgonomics-api-dev
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Storage Engine (Local mock or noop)
STORAGE_DRIVER=noop
STORAGE_BUCKET=burgonomics-dev-bucket
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=dev_key
STORAGE_SECRET_ACCESS_KEY=dev_secret
STORAGE_ENDPOINT=
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/public/uploads

# Feature Flags (All turned on for easy dev testing)
FEATURE_FLAGS_DRIVER=env
FEATURE_BETA=true
FEATURE_DELIVERY=true
FEATURE_DINE_IN=true
FEATURE_OFFERS=true
FEATURE_TAKEAWAY=true
FEATURE_NEW_CHECKOUT=true
FEATURE_FESTIVAL_CAMPAIGNS=true

# Firebase Auth Configuration (Dev project)
FIREBASE_PROJECT_ID=burgonomics-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@burgonomics-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN+PRIVATE+KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQDh...\n-----END+PRIVATE+KEY-----\n

# Third-Party Integrations (Sandbox/Test Modes)
PETPOOJA_BASE_URL=https://sandbox.petpooja.com/v1
PETPOOJA_APP_KEY=sandbox_app_key_here
PETPOOJA_APP_SECRET=sandbox_app_secret_here
PETPOOJA_ACCESS_TOKEN=sandbox_access_token_here
PETPOOJA_HTTP_TIMEOUT_MS=5000
PETPOOJA_WEBHOOK_SECRET=sandbox_webhook_secret_here

RAZORPAY_KEY_ID=rzp_test_devkey123
RAZORPAY_KEY_SECRET=testsecret123
RAZORPAY_WEBHOOK_SECRET=testwebhooksecret123

# OTP Configuration
SMS_PROVIDER=noop
WHATSAPP_PROVIDER=noop
OTP_SYMMETRIC_SECRET=dev_otp_symmetric_secret_key_123456

# VITE Public Frontend Configs
VITE_API_URL=http://localhost:3000
VITE_APP_ENV=development
VITE_MAPS_KEY=dev_google_maps_key
VITE_RAZORPAY_KEY=rzp_test_devkey123
VITE_PAYMENTS_API_BASE_URL=http://localhost:3000/api/v1
