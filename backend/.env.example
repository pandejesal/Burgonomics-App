# ─── BURGONOMICS BACKEND CONFIGURATION TEMPLATE (.env.example) ───────
# Copy this file to .env, .env.development, or configure in deployment environment.
# NEVER commit real production secrets to version control.

# Application General
NODE_ENV=development
APP_NAME=burgonomics-backend
APP_PORT=3000
APP_GLOBAL_PREFIX=api/v1
APP_CORS_ORIGINS=https://burgonomics.com,https://www.burgonomics.com,http://localhost:5173,http://localhost:3000
LOG_LEVEL=info

# Database (PostgreSQL with Prisma)
DATABASE_URL=postgresql://burgonomics_user:your_secure_password@localhost:5432/burgonomics?schema=public

# Redis Cache & Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# Cache TTL Configuration
CACHE_DEFAULT_TTL_SECONDS=60
CACHE_MENU_TTL_SECONDS=300

# Background Worker (BullMQ)
BULLMQ_PREFIX=burgonomics
BULLMQ_DEFAULT_ATTEMPTS=5
BULLMQ_DEFAULT_BACKOFF_MS=2000

# Customer JWT Authentication (Min 32 characters high entropy)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_long_entropy
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_long_entropy
JWT_REFRESH_TTL=30d
JWT_ISSUER=burgonomics
JWT_AUDIENCE=burgonomics-mobile

# Admin JWT Authentication (Min 32 characters - Boot fails hard if unset)
ADMIN_JWT_ACCESS_SECRET=your_admin_jwt_access_secret_min_32_chars_long
ADMIN_JWT_REFRESH_SECRET=your_admin_jwt_refresh_secret_min_32_chars_long

# Initial Seed Admin Provisioning (Optional, for prisma/seed.ts)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Rate Limiting
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120

# Webhook Security
WEBHOOK_REPLAY_WINDOW_SECONDS=300

# PETPOOJA POS Integration
PETPOOJA_BASE_URL=https://api.petpooja.com
PETPOOJA_APP_KEY=your_petpooja_app_key
PETPOOJA_APP_SECRET=your_petpooja_app_secret
PETPOOJA_ACCESS_TOKEN=your_petpooja_access_token
PETPOOJA_WEBHOOK_SECRET=your_petpooja_webhook_secret
PETPOOJA_HTTP_TIMEOUT_MS=15000

# Razorpay Payments Integration
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_HTTP_TIMEOUT_MS=15000
RAZORPAY_REPLAY_WINDOW_SECONDS=300
RAZORPAY_ORDER_EXPIRY_MINUTES=15

# Firebase Admin SDK (Optional / Service Account)
FIREBASE_PROJECT_ID=burgonomics-7faa8
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Storage Engine (noop | s3 | r2 | minio | azure | gcs)
STORAGE_DRIVER=noop
STORAGE_BUCKET=burgonomics-uploads
STORAGE_REGION=ap-south-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/public/uploads

# Telemetry / Sentry
SENTRY_DSN=
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs
METRICS_ENABLED=true
OTEL_ENABLED=false
