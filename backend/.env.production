# ─── PRODUCTION ENVIRONMENT CONFIGURATION ─────────────────────────
# FULLY SECURED, high availability, telemetry active, hardened.

# App General
APP_NAME=BURGONOMICS
APP_PORT=3000
APP_GLOBAL_PREFIX=api/v1
APP_CORS_ORIGINS=https://burgonomics.com,https://admin.burgonomics.com,https://api.burgonomics.com

# Logging & Debugging
LOG_LEVEL=warn
SENTRY_DSN=https://sentry_production_dsn@sentry.io/789012
SWAGGER_ENABLED=false
SWAGGER_PATH=api/docs # Disabled or secure route

# Databases & Cache (HA Cloud Databases with connection pooling)
DATABASE_URL=postgresql://burg_prod_user:HARDENED_PROD_DB_PASSWORD_LONG_123@prod-db-replica.burgonomics.com:5432/burgonomics_prod?sslmode=verify-full&sslrootcert=/etc/ssl/certs/db-root.crt
REDIS_HOST=prod-redis-cluster.burgonomics.com
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=HARDENED_PROD_REDIS_PASSWORD_LONG_123
REDIS_TLS=true

# Cache TTLs (Optimal production cache times)
CACHE_DEFAULT_TTL_SECONDS=1800
CACHE_MENU_TTL_SECONDS=600

# Background Worker (BullMQ)
BULLMQ_PREFIX=burg_prod
BULLMQ_DEFAULT_ATTEMPTS=5
BULLMQ_DEFAULT_BACKOFF_MS=5000

# Security & Sessions (Symmetric encryption, high entropy keys)
JWT_ACCESS_SECRET=ROTATING_PRODUCTION_HIGH_ENTROPY_ACCESS_SECRET_KEY_98327489237498237498237498
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=ROTATING_PRODUCTION_HIGH_ENTROPY_REFRESH_SECRET_KEY_98327489237498237498237498
JWT_REFRESH_TTL=7d
JWT_ISSUER=burgonomics.com
JWT_AUDIENCE=burgonomics-app-prod

# Rate Limiting (Strict protection against DDoS and abuse)
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=60

# Telemetry / Observability
METRICS_ENABLED=true
OTEL_ENABLED=true
OTEL_SERVICE_NAME=burgonomics-api-prod
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.prod.internal:4317

# Storage Engine (Amazon S3 or GCS with CDN proxy)
STORAGE_DRIVER=s3
STORAGE_BUCKET=burgonomics-prod-assets-us-east-1
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=PROD_IAM_USER_S3_KEY_ID_8239
STORAGE_SECRET_ACCESS_KEY=PROD_IAM_USER_S3_SECRET_ACCESS_KEY_ROTATING_8239
STORAGE_ENDPOINT=https://s3.amazonaws.com
STORAGE_PUBLIC_BASE_URL=https://assets.burgonomics.com

# Feature Flags (Controlled rollouts of stable features)
FEATURE_FLAGS_DRIVER=env
FEATURE_BETA=false
FEATURE_DELIVERY=true
FEATURE_DINE_IN=true
FEATURE_OFFERS=true
FEATURE_TAKEAWAY=true
FEATURE_NEW_CHECKOUT=true
FEATURE_FESTIVAL_CAMPAIGNS=true

# Firebase Auth Configuration (Production project)
FIREBASE_PROJECT_ID=burgonomics-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@burgonomics-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN+PRIVATE+KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END+PRIVATE+KEY-----\n

# Third-Party Integrations (LIVE Credentials - MUST be stored in safe vault)
PETPOOJA_BASE_URL=https://api.petpooja.com/v1
PETPOOJA_APP_KEY=LIVE_PRODUCTION_PETPOOJA_APP_KEY
PETPOOJA_APP_SECRET=LIVE_PRODUCTION_PETPOOJA_APP_SECRET
PETPOOJA_ACCESS_TOKEN=LIVE_PRODUCTION_PETPOOJA_ACCESS_TOKEN
PETPOOJA_HTTP_TIMEOUT_MS=10000
PETPOOJA_WEBHOOK_SECRET=LIVE_PRODUCTION_PETPOOJA_WEBHOOK_SECRET

RAZORPAY_KEY_ID=rzp_live_productionkey456
RAZORPAY_KEY_SECRET=LIVE_PRODUCTION_RAZORPAY_SECRET_456
RAZORPAY_WEBHOOK_SECRET=LIVE_PRODUCTION_RAZORPAY_WEBHOOK_SECRET_456

# OTP Configuration (Production Multi-Channel Providers)
SMS_PROVIDER=msg91
WHATSAPP_PROVIDER=msg91
MSG91_API_KEY=LIVE_PRODUCTION_MSG91_API_KEY
MSG91_TEMPLATE_ID=LIVE_PRODUCTION_MSG91_TEMPLATE_ID
MSG91_SENDER_ID=BURGER
OTP_SYMMETRIC_SECRET=LIVE_PRODUCTION_OTP_SYMMETRIC_SECRET_982348

# VITE Public Frontend Configs
VITE_API_URL=https://burgonomics.com
VITE_APP_ENV=production
VITE_MAPS_KEY=PRODUCTION_GOOGLE_MAPS_API_KEY
VITE_RAZORPAY_KEY=rzp_live_productionkey456
VITE_PAYMENTS_API_BASE_URL=https://burgonomics.com/api/v1
