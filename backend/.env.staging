# ─── STAGING ENVIRONMENT CONFIGURATION ───────────────────────────
# Pre-production validation, real cloud DBs, sandbox gateways, active logging.

# App General
APP_NAME=BURGONOMICS-Staging
APP_PORT=3000
APP_GLOBAL_PREFIX=api/v1
APP_CORS_ORIGINS=https://staging.burgonomics.com,https://admin-staging.burgonomics.com

# Logging & Debugging
LOG_LEVEL=info
SENTRY_DSN=https://sentry_staging_dsn@sentry.io/123456
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# Databases & Cache (Managed Staging Services)
DATABASE_URL=postgresql://burg_staging_user:StagingPassword_Strong_99@staging-db.burgonomics.com:5432/burgonomics_staging?sslmode=require
REDIS_HOST=staging-redis.burgonomics.com
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=StagingRedisPassword_Strong_99
REDIS_TLS=true

# Cache TTLs (Realistic staging cache times)
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_MENU_TTL_SECONDS=120

# Background Worker (BullMQ)
BULLMQ_PREFIX=burg_staging
BULLMQ_DEFAULT_ATTEMPTS=5
BULLMQ_DEFAULT_BACKOFF_MS=3000

# Security & Sessions
JWT_ACCESS_SECRET=staging_high_entropy_secret_key_rotation_389274928374
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=staging_high_entropy_refresh_secret_key_rotation_389274928374
JWT_REFRESH_TTL=14d
JWT_ISSUER=burgonomics.com
JWT_AUDIENCE=burgonomics-app-staging

# Rate Limiting
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=150

# Telemetry / Observability
METRICS_ENABLED=true
OTEL_ENABLED=true
OTEL_SERVICE_NAME=burgonomics-api-staging
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.staging:4317

# Storage Engine (S3 / Cloud Storage Bucket)
STORAGE_DRIVER=s3
STORAGE_BUCKET=burgonomics-staging-assets
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=staging_iam_s3_key_id
STORAGE_SECRET_ACCESS_KEY=staging_iam_s3_secret_access_key
STORAGE_ENDPOINT=https://s3.amazonaws.com
STORAGE_PUBLIC_BASE_URL=https://staging-assets.burgonomics.com

# Feature Flags (Selectively activated features for testing)
FEATURE_FLAGS_DRIVER=env
FEATURE_BETA=true
FEATURE_DELIVERY=true
FEATURE_DINE_IN=true
FEATURE_OFFERS=true
FEATURE_TAKEAWAY=true
FEATURE_NEW_CHECKOUT=true
FEATURE_FESTIVAL_CAMPAIGNS=false

# Firebase Auth Configuration (Staging project)
FIREBASE_PROJECT_ID=burgonomics-staging
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@burgonomics-staging.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN+PRIVATE+KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END+PRIVATE+KEY-----\n

# Third-Party Integrations (Sandboxes with actual connections)
PETPOOJA_BASE_URL=https://sandbox.petpooja.com/v1
PETPOOJA_APP_KEY=staging_petpooja_app_key_3892
PETPOOJA_APP_SECRET=staging_petpooja_app_secret_8923
PETPOOJA_ACCESS_TOKEN=staging_petpooja_access_token_7721
PETPOOJA_HTTP_TIMEOUT_MS=8000
PETPOOJA_WEBHOOK_SECRET=staging_petpooja_webhook_secret_9981

RAZORPAY_KEY_ID=rzp_test_stagingkey123
RAZORPAY_KEY_SECRET=stagingsecret123
RAZORPAY_WEBHOOK_SECRET=stagingwebhooksecret123

# OTP Configuration (Msg91 Staging environment)
SMS_PROVIDER=msg91
WHATSAPP_PROVIDER=msg91
MSG91_API_KEY=staging_msg91_api_key_839182
MSG91_TEMPLATE_ID=staging_template_id
MSG91_SENDER_ID=BURGDV
OTP_SYMMETRIC_SECRET=staging_otp_symmetric_secret_key_8329482

# VITE Public Frontend Configs
VITE_API_URL=https://staging.burgonomics.com
VITE_APP_ENV=staging
VITE_MAPS_KEY=staging_google_maps_key
VITE_RAZORPAY_KEY=rzp_test_stagingkey123
VITE_PAYMENTS_API_BASE_URL=https://staging.burgonomics.com/api/v1
