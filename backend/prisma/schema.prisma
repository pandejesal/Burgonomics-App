// Burgonomics Backend — Prisma schema.
//
// Phase 1: infrastructure-only tables.
// Phase 2: identity, addresses, stores.
// Phase 3: Catalog domain (categories, products, modifier groups,
// modifiers, product↔store availability, offers, menu sync log,
// search query log). All catalog data is PETPOOJA-owned; manual CRUD
// is forbidden — writes only through the synchronization pipeline.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Identity ──────────────────────────────────────────────────
model User {
  id          String   @id @default(cuid())
  phone       String   @unique
  email       String?  @unique
  name        String?
  avatarUrl   String?
  role        UserRole @default(CUSTOMER)
  isActive    Boolean  @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  preferences   UserPreference?
  addresses     Address[]
  refreshTokens RefreshToken[]

  @@index([role])
  @@map("users")
}

enum UserRole {
  CUSTOMER
  STORE_STAFF
  STORE_MANAGER
  ADMIN
  SUPER_ADMIN
}

model UserPreference {
  id                   String   @id @default(cuid())
  userId               String   @unique
  language             String   @default("en")
  theme                String   @default("system")
  notificationsEnabled Boolean  @default(true)
  marketingOptIn       Boolean  @default(false)
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

model OtpRequest {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  purpose    OtpPurpose @default(LOGIN)
  attempts   Int       @default(0)
  verifiedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@map("otp_requests")
}

enum OtpPurpose {
  LOGIN
  PHONE_CHANGE
  ACCOUNT_RECOVERY
}

// ─── Addresses ─────────────────────────────────────────────────
model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  pincode   String
  country   String   @default("IN")
  latitude  Float?
  longitude Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
  @@map("addresses")
}

// ─── Stores ────────────────────────────────────────────────────
model Store {
  id              String       @id @default(cuid())
  petpoojaRestId  String       @unique
  name            String
  address         String
  city            String
  state           String
  pincode         String
  country         String       @default("IN")
  phone           String?
  latitude        Float?
  longitude       Float?
  status          StoreStatus  @default(CLOSED)
  turnOnAt        DateTime?
  minPrepMinutes  Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  hours StoreHours[]

  @@index([status])
  @@map("stores")
}

enum StoreStatus {
  OPEN
  CLOSED
  PAUSED
}

model StoreHours {
  id        String @id @default(cuid())
  storeId   String
  dayOfWeek Int    // 0 = Sunday
  openTime  String // "HH:mm"
  closeTime String

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, dayOfWeek, openTime])
  @@map("store_hours")
}

// ─── Idempotency ───────────────────────────────────────────────
model IdempotencyKey {
  id           String   @id @default(cuid())
  userId       String?
  endpoint     String
  key          String
  responseHash String?
  statusCode   Int?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@unique([userId, endpoint, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ─── Transactional Outbox ──────────────────────────────────────
model OutboxEvent {
  id            String       @id @default(cuid())
  aggregateId   String
  aggregateType String
  eventType     String
  payload       Json
  correlationId String?
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?
  createdAt     DateTime     @default(now())
  publishedAt   DateTime?
  scheduledFor  DateTime     @default(now())

  @@index([status, scheduledFor])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
  DEAD_LETTER
}

// ─── PETPOOJA Webhook Audit ────────────────────────────────────
model PetpoojaWebhookEvent {
  id            String        @id @default(cuid())
  webhookType   String
  rawPayload    Json
  signature     String?
  receivedAt    DateTime      @default(now())
  status        WebhookStatus @default(RECEIVED)
  processedAt   DateTime?
  lastError     String?
  attempts      Int           @default(0)
  correlationId String?

  @@index([status, receivedAt])
  @@index([webhookType, receivedAt])
  @@map("petpooja_webhook_events")
}

enum WebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  DEAD_LETTER
}

// ─── Feature Flags (runtime toggles) ───────────────────────────
model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("feature_flags")
}

// ─── Audit Log ─────────────────────────────────────────────────
model AuditLog {
  id            String   @id @default(cuid())
  actorId       String?
  actorRole     String?
  action        String
  resourceType  String
  resourceId    String?
  previousValue Json?
  newValue      Json?
  metadata      Json?
  ip            String?
  userAgent     String?
  correlationId String?
  createdAt     DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Catalog: Categories ───────────────────────────────────────
model Category {
  id             String   @id @default(cuid())
  petpoojaId     String   @unique
  name           String
  description    String?
  imageUrl       String?
  bannerUrl      String?
  displayOrder   Int      @default(0)
  isVisible      Boolean  @default(true)
  isAvailable    Boolean  @default(true)
  availableFrom  String?  // "HH:mm" — future scheduling
  availableTo    String?
  translations   Json?    // future multilingual: { "en": "...", "hi": "..." }
  parentId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([isVisible, displayOrder])
  @@index([parentId])
  @@map("categories")
}

// ─── Catalog: Products ─────────────────────────────────────────
// INVARIANT: Every product is PURE VEG. There is no `isVeg` flag; the
// domain forbids representing non-veg products at all.
model Product {
  id                String   @id @default(cuid())
  petpoojaId        String   @unique
  categoryId        String
  name              String
  description       String?
  shortDescription  String?
  basePrice         Decimal  @db.Decimal(10, 2)
  taxRate           Decimal  @db.Decimal(5, 2) @default(0)
  taxCode           String?
  currency          String   @default("INR")
  displayOrder      Int      @default(0)
  isAvailable       Boolean  @default(true)
  prepTimeMinutes   Int?
  calories          Int?
  proteinG          Decimal? @db.Decimal(6, 2)
  carbsG            Decimal? @db.Decimal(6, 2)
  fatG              Decimal? @db.Decimal(6, 2)
  fiberG            Decimal? @db.Decimal(6, 2)
  servingSize       String?
  allergens         String[] @default([])
  tags              String[] @default([])
  isPopular         Boolean  @default(false)
  isRecommended     Boolean  @default(false)
  isBestSeller      Boolean  @default(false)
  isFeatured        Boolean  @default(false)
  isSeasonal        Boolean  @default(false)
  seasonalFrom      DateTime?
  seasonalTo        DateTime?
  translations      Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  category           Category                    @relation(fields: [categoryId], references: [id])
  images             ProductImage[]
  storeAvailability  ProductStoreAvailability[]
  modifierGroups     ProductModifierGroup[]

  @@index([categoryId, displayOrder])
  @@index([isAvailable])
  @@index([isPopular])
  @@index([isFeatured])
  @@index([isBestSeller])
  @@index([name])
  @@map("products")
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String
  url          String
  altText      String?
  displayOrder Int      @default(0)
  isPrimary    Boolean  @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, displayOrder])
  @@map("product_images")
}

model ProductStoreAvailability {
  id          String   @id @default(cuid())
  productId   String
  storeId     String
  isAvailable Boolean  @default(true)
  inStock     Boolean  @default(true)
  priceOverride Decimal? @db.Decimal(10, 2)
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, storeId])
  @@index([storeId, isAvailable])
  @@index([storeId, inStock])
  @@map("product_store_availability")
}

// ─── Catalog: Modifier Groups & Modifiers ──────────────────────
model ModifierGroup {
  id               String   @id @default(cuid())
  petpoojaId       String   @unique
  name             String
  description      String?
  minSelection     Int      @default(0)
  maxSelection     Int      @default(1)
  isRequired       Boolean  @default(false)
  allowMultiple    Boolean  @default(false)
  displayOrder     Int      @default(0)
  isAvailable      Boolean  @default(true)
  translations     Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  modifiers ModifierOption[]
  products  ProductModifierGroup[]

  @@map("modifier_groups")
}

model ModifierOption {
  id             String   @id @default(cuid())
  petpoojaId     String   @unique
  groupId        String
  name           String
  price          Decimal  @db.Decimal(10, 2) @default(0)
  displayOrder   Int      @default(0)
  isAvailable    Boolean  @default(true)
  isDefault      Boolean  @default(false)
  translations   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  group ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, displayOrder])
  @@map("modifier_options")
}

model ProductModifierGroup {
  productId String
  groupId   String
  sortOrder Int    @default(0)

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  group   ModifierGroup @relation(fields: [groupId],   references: [id], onDelete: Cascade)

  @@id([productId, groupId])
  @@index([groupId])
  @@map("product_modifier_groups")
}

// ─── Catalog: Offers ───────────────────────────────────────────
model Offer {
  id              String     @id @default(cuid())
  petpoojaId      String?    @unique
  code            String?    @unique  // coupon code, when applicable
  title           String
  description     String?
  type            OfferType
  scope           OfferScope
  discountKind    DiscountKind
  discountValue   Decimal    @db.Decimal(10, 2)
  maxDiscount     Decimal?   @db.Decimal(10, 2)
  minOrderValue   Decimal?   @db.Decimal(10, 2)
  storeIds        String[]   @default([])
  categoryIds     String[]   @default([])
  productIds      String[]   @default([])
  comboProductIds String[]   @default([])
  requiresLogin   Boolean    @default(false)
  requiresCoupon  Boolean    @default(false)
  usageLimit      Int?
  perUserLimit    Int?
  startsAt        DateTime?
  endsAt          DateTime?
  bannerUrl       String?
  displayOrder    Int        @default(0)
  isActive        Boolean    @default(true)
  metadata        Json?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([isActive, startsAt, endsAt])
  @@index([scope])
  @@index([type])
  @@map("offers")
}

enum OfferType {
  PROMOTIONAL
  COUPON
  COMBO
  LOYALTY
  MEMBERSHIP
}

enum OfferScope {
  STORE
  CATEGORY
  PRODUCT
  COMBO
  CART
}

enum DiscountKind {
  PERCENTAGE
  FLAT
  FREE_ITEM
  BOGO
}

// ─── Catalog: Menu Sync Log ────────────────────────────────────
model MenuSyncLog {
  id            String        @id @default(cuid())
  storeId       String?
  syncType      String        // STORES | CATEGORIES | PRODUCTS | MODIFIERS | OFFERS | FULL | STOCK | STORE_STATUS
  status        MenuSyncStatus @default(PENDING)
  version       String?
  itemsCreated  Int           @default(0)
  itemsUpdated  Int           @default(0)
  itemsDeleted  Int           @default(0)
  conflicts     Int           @default(0)
  errorMessage  String?
  correlationId String?
  startedAt     DateTime      @default(now())
  finishedAt    DateTime?

  @@index([syncType, status, startedAt])
  @@index([storeId, startedAt])
  @@map("menu_sync_logs")
}

enum MenuSyncStatus {
  PENDING
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

// ─── Catalog: Search Query Log ─────────────────────────────────
model SearchQueryLog {
  id         String   @id @default(cuid())
  userId     String?
  query      String
  scope      String   @default("all")
  resultCount Int     @default(0)
  createdAt  DateTime @default(now())

  @@index([query])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("search_query_logs")
}

// ─── Commerce: Fulfillment / Enums ─────────────────────────────
enum FulfillmentType {
  DELIVERY
  TAKEAWAY
  DINE_IN
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
  EXPIRED
}

enum CheckoutSessionStatus {
  DRAFT
  VALIDATED
  LOCKED
  EXPIRED
  CONVERTED
  FAILED
}

// Mirrors the strongly-typed `OrderState` state-machine in code.
enum OrderStatus {
  CART
  CHECKOUT
  PAYMENT_PENDING
  PAYMENT_VERIFIED
  ORDER_CREATED
  ORDER_SENT_TO_PETPOOJA
  ORDER_ACCEPTED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
  FAILED
  REFUNDED
}

enum OrderEventType {
  STATE_CHANGED
  PAYMENT_LINKED
  PETPOOJA_LINKED
  PETPOOJA_ACK
  CUSTOMER_NOTE
  SYSTEM_NOTE
  CANCELLATION_REQUESTED
  REFUND_INITIATED
  REFUND_COMPLETED
}

// ─── Commerce: Cart ────────────────────────────────────────────
model Cart {
  id              String     @id @default(cuid())
  userId          String?
  anonymousId     String?
  storeId         String?
  fulfillment     FulfillmentType @default(TAKEAWAY)
  addressId       String?
  tableNumber     String?
  status          CartStatus @default(ACTIVE)
  currency        String     @default("INR")
  notes           String?
  expiresAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  items           CartItem[]

  @@index([userId, status])
  @@index([anonymousId, status])
  @@index([storeId, status])
  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id                String   @id @default(cuid())
  cartId            String
  productId         String
  productPetpoojaId String
  name              String
  quantity          Int      @default(1)
  unitPrice         Decimal  @db.Decimal(10, 2)
  taxRate           Decimal  @db.Decimal(5, 2) @default(0)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  cart      Cart               @relation(fields: [cartId], references: [id], onDelete: Cascade)
  modifiers CartItemModifier[]

  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

model CartItemModifier {
  id                 String  @id @default(cuid())
  cartItemId         String
  groupId            String
  groupName          String
  optionId           String
  optionPetpoojaId   String
  optionName         String
  priceDelta         Decimal @db.Decimal(10, 2) @default(0)

  cartItem CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)

  @@index([cartItemId])
  @@map("cart_item_modifiers")
}

// ─── Commerce: Checkout Session ────────────────────────────────
model CheckoutSession {
  id              String                 @id @default(cuid())
  cartId          String                 @unique
  userId          String
  storeId         String
  fulfillment     FulfillmentType
  addressId       String?
  tableNumber     String?
  status          CheckoutSessionStatus  @default(DRAFT)
  couponCode      String?
  pricingSnapshot Json?
  taxSnapshot     Json?
  prepEtaMinutes  Int?
  expiresAt       DateTime
  validatedAt     DateTime?
  lockedAt        DateTime?
  convertedAt     DateTime?
  orderId         String?                @unique
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([userId, status])
  @@index([storeId, status])
  @@index([expiresAt])
  @@map("checkout_sessions")
}

// ─── Commerce: Coupons ─────────────────────────────────────────
model Coupon {
  id              String       @id @default(cuid())
  code            String       @unique
  title           String
  description     String?
  discountKind    DiscountKind
  discountValue   Decimal      @db.Decimal(10, 2)
  maxDiscount     Decimal?     @db.Decimal(10, 2)
  minOrderValue   Decimal?     @db.Decimal(10, 2)
  storeIds        String[]     @default([])
  categoryIds     String[]     @default([])
  productIds      String[]     @default([])
  usageLimit      Int?
  perUserLimit    Int?
  usageCount      Int          @default(0)
  requiresLogin   Boolean      @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  isActive        Boolean      @default(true)
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  redemptions CouponRedemption[]

  @@index([isActive, startsAt, endsAt])
  @@map("coupons")
}

model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  userId     String
  orderId    String?
  discount   Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
  @@index([userId, createdAt])
  @@map("coupon_redemptions")
}

// ─── Commerce: Orders ──────────────────────────────────────────
model Order {
  id                  String          @id @default(cuid())
  clientOrderId       String          @unique
  petpoojaOrderId     String?         @unique
  userId              String
  storeId             String
  addressId           String?
  fulfillment         FulfillmentType
  status              OrderStatus     @default(ORDER_CREATED)
  tableNumber         String?
  currency            String          @default("INR")
  subtotal            Decimal         @db.Decimal(10, 2)
  itemDiscount        Decimal         @db.Decimal(10, 2) @default(0)
  offerDiscount       Decimal         @db.Decimal(10, 2) @default(0)
  couponDiscount      Decimal         @db.Decimal(10, 2) @default(0)
  couponCode          String?
  taxes               Decimal         @db.Decimal(10, 2) @default(0)
  packingFee          Decimal         @db.Decimal(10, 2) @default(0)
  deliveryFee         Decimal         @db.Decimal(10, 2) @default(0)
  serviceCharge       Decimal         @db.Decimal(10, 2) @default(0)
  roundOff            Decimal         @db.Decimal(10, 2) @default(0)
  grandTotal          Decimal         @db.Decimal(10, 2)
  pricingSnapshot     Json
  taxSnapshot         Json?
  customerNotes       String?
  paymentReference    String?
  prepEtaMinutes      Int?
  placedAt            DateTime        @default(now())
  acceptedAt          DateTime?
  readyAt             DateTime?
  dispatchedAt        DateTime?
  deliveredAt         DateTime?
  cancelledAt         DateTime?
  cancellationReason  String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  items  OrderItem[]
  events OrderEvent[]

  @@index([userId, placedAt])
  @@index([storeId, status])
  @@index([status, placedAt])
  @@map("orders")
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  productId         String
  productPetpoojaId String
  name              String
  quantity          Int
  unitPrice         Decimal  @db.Decimal(10, 2)
  taxRate           Decimal  @db.Decimal(5, 2) @default(0)
  lineTotal         Decimal  @db.Decimal(10, 2)
  notes             String?

  order     Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  modifiers OrderItemModifier[]

  @@index([orderId])
  @@map("order_items")
}

model OrderItemModifier {
  id                 String  @id @default(cuid())
  orderItemId        String
  groupId            String
  groupName          String
  optionId           String
  optionPetpoojaId   String
  optionName         String
  priceDelta         Decimal @db.Decimal(10, 2) @default(0)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@map("order_item_modifiers")
}

model OrderEvent {
  id            String         @id @default(cuid())
  orderId       String
  type          OrderEventType
  fromStatus    OrderStatus?
  toStatus      OrderStatus?
  message       String?
  metadata      Json?
  actorId       String?
  correlationId String?
  createdAt     DateTime       @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([type, createdAt])
  @@map("order_events")
}


// ─── Payments (Razorpay) ───────────────────────────────────────
model Payment {
  id                  String         @id @default(cuid())
  orderId             String
  userId              String
  receipt             String         @unique
  gateway             String         @default("razorpay")
  gatewayOrderId      String?        @unique
  gatewayPaymentId    String?        @unique
  amount              Decimal        @db.Decimal(12, 2)
  amountRefunded      Decimal        @db.Decimal(12, 2) @default(0)
  currency            String         @default("INR")
  method              String?
  status              PaymentStatus  @default(CREATED)
  failureCode         String?
  failureDescription  String?
  notes               Json?
  metadata            Json?
  capturedAt          DateTime?
  failedAt            DateTime?
  verifiedAt          DateTime?
  expiresAt           DateTime?
  correlationId       String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  attempts PaymentAttempt[]
  refunds  Refund[]

  @@index([orderId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  VERIFIED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
  EXPIRED
}

model PaymentAttempt {
  id             String              @id @default(cuid())
  paymentId      String
  attemptNo      Int                 @default(1)
  action         PaymentAttemptKind
  status         String
  gatewayCode    String?
  gatewayMessage String?
  request        Json?
  response       Json?
  correlationId  String?
  createdAt      DateTime            @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@map("payment_attempts")
}

enum PaymentAttemptKind {
  CREATE_ORDER
  VERIFY
  CAPTURE
  FETCH
  REFUND
  WEBHOOK
}

model Refund {
  id                 String        @id @default(cuid())
  paymentId          String
  orderId            String
  gatewayRefundId    String?       @unique
  amount             Decimal       @db.Decimal(12, 2)
  currency           String        @default("INR")
  reason             String?
  status             RefundStatus  @default(PENDING)
  speed              String        @default("normal")
  isPartial          Boolean       @default(false)
  failureCode        String?
  failureDescription String?
  notes              Json?
  requestedBy        String?
  processedAt        DateTime?
  failedAt           DateTime?
  correlationId      String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@index([orderId, createdAt])
  @@index([status, createdAt])
  @@map("refunds")
}

enum RefundStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  CANCELLED
}

model PaymentWebhookEvent {
  id             String        @id @default(cuid())
  gateway        String        @default("razorpay")
  eventType      String
  gatewayEventId String?       @unique
  rawPayload     Json
  signature      String?
  status         WebhookStatus @default(RECEIVED)
  attempts       Int           @default(0)
  lastError      String?
  processedAt    DateTime?
  correlationId  String?
  receivedAt     DateTime      @default(now())

  @@index([status, receivedAt])
  @@index([eventType, receivedAt])
  @@map("payment_webhook_events")
}

// ─── Realtime Communication Platform (Phase 7) ────────────────

model Device {
  id                     String   @id @default(cuid())
  userId                 String
  token                  String   @unique
  platform               DevicePlatform
  appVersion             String?
  osVersion              String?
  deviceModel            String?
  language               String   @default("en")
  timezone               String?
  fcmProjectId           String?
  pushEnabled            Boolean  @default(true)
  isActive               Boolean  @default(true)
  lastSeenAt             DateTime @default(now())
  registeredAt           DateTime @default(now())
  revokedAt              DateTime?
  metadata               Json?

  @@index([userId, isActive])
  @@index([platform, isActive])
  @@index([lastSeenAt])
  @@map("devices")
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

model NotificationTemplate {
  id             String   @id @default(cuid())
  code           String
  type           String
  channel        NotificationChannel
  locale         String   @default("en")
  title          String
  body           String
  dataDefaults   Json?
  isActive       Boolean  @default(true)
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([code, locale, channel])
  @@map("notification_templates")
}

model Notification {
  id             String              @id @default(cuid())
  userId         String
  type           String
  category       NotificationCategory @default(GENERAL)
  title          String
  body           String
  data           Json?
  deeplink       String?
  imageUrl       String?
  channel        NotificationChannel  @default(PUSH)
  priority       NotificationPriority @default(NORMAL)
  status         NotificationStatus   @default(PENDING)
  readAt         DateTime?
  archivedAt     DateTime?
  templateCode   String?
  templateVersion Int?
  correlationId  String?
  refType        String?
  refId          String?
  scheduledAt    DateTime?
  expiresAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  deliveries     NotificationDelivery[]

  @@index([userId, createdAt])
  @@index([userId, status, createdAt])
  @@index([userId, category, readAt])
  @@index([type, createdAt])
  @@map("notifications")
}

enum NotificationCategory {
  ORDER
  PAYMENT
  OFFER
  SYSTEM
  GENERAL
  LOYALTY
  MEMBERSHIP
}

enum NotificationChannel {
  PUSH
  SSE
  EMAIL
  SMS
  IN_APP
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum NotificationStatus {
  PENDING
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  EXPIRED
  ARCHIVED
}

model NotificationDelivery {
  id             String             @id @default(cuid())
  notificationId String
  channel        NotificationChannel
  deviceId       String?
  status         DeliveryStatus     @default(PENDING)
  attempt        Int                @default(0)
  providerRef    String?
  providerCode   String?
  providerMessage String?
  latencyMs      Int?
  attemptedAt    DateTime           @default(now())
  ackAt          DateTime?

  notification   Notification       @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId, channel])
  @@index([status, attemptedAt])
  @@map("notification_deliveries")
}

enum DeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
  ABANDONED
}

model NotificationChannelPreference {
  id           String              @id @default(cuid())
  userId       String
  category     NotificationCategory
  channel      NotificationChannel
  enabled      Boolean             @default(true)
  updatedAt    DateTime            @updatedAt

  @@unique([userId, category, channel])
  @@map("notification_channel_preferences")
}

model RealtimeSession {
  id             String   @id @default(cuid())
  userId         String
  instanceId     String
  stream         String
  correlationId  String?
  userAgent      String?
  ip             String?
  connectedAt    DateTime @default(now())
  lastPingAt     DateTime @default(now())
  disconnectedAt DateTime?

  @@index([userId, disconnectedAt])
  @@index([instanceId])
  @@index([stream, disconnectedAt])
  @@map("realtime_sessions")
}

// ─── RBAC ──────────────────────────────────────────────────────
model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@index([resource])
  @@map("permissions")
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRoleAssignment[]

  @@map("roles")
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
  scope      String   @default("") // optional store-scope etc.
  assignedBy String?
  createdAt  DateTime @default(now())

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, scope])
  @@index([userId])
  @@map("user_role_assignments")
}

// ─── System Configuration ──────────────────────────────────────
model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  category    String   @default("general")
  version     Int      @default(1)
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  history SystemConfigVersion[]

  @@index([category])
  @@map("system_configs")
}

model SystemConfigVersion {
  id         String   @id @default(cuid())
  configId   String
  version    Int
  value      Json
  changedBy  String?
  changeNote String?
  createdAt  DateTime @default(now())

  config SystemConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, version])
  @@map("system_config_versions")
}

// ─── Reports ───────────────────────────────────────────────────
model ReportJob {
  id           String     @id @default(cuid())
  type         String
  status       ReportStatus @default(PENDING)
  format       String     @default("csv")
  params       Json?
  requestedBy  String?
  fileUrl      String?
  fileSize     Int?
  rowCount     Int?
  error        String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([type, status])
  @@index([requestedBy, createdAt])
  @@map("report_jobs")
}

enum ReportStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// ─── Admin Portal Models ──────────────────────────────────────

model AdminUser {
  id           String         @id @default(cuid())
  uuid         String         @unique @default(uuid())
  email        String         @unique
  passwordHash String
  fullName     String
  avatar       String?
  roleId       String
  isActive     Boolean        @default(true)
  isDeveloper  Boolean        @default(false)
  totpSecret   String?
  lastLoginAt  DateTime?
  lastSeenAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  role         AdminRole      @relation(fields: [roleId], references: [id])
  sessions     AdminSession[]
  auditLogs    AdminAuditLog[]

  @@index([email])
  @@index([roleId])
  @@map("admin_users")
}

model AdminRole {
  id           String                 @id @default(cuid())
  name         String                 @unique
  description  String?
  isSystemRole Boolean                @default(false)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  users        AdminUser[]
  permissions  AdminRolePermission[]

  @@map("admin_roles")
}

model AdminPermission {
  id          String                 @id @default(cuid())
  key         String                 @unique
  description String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  roles       AdminRolePermission[]

  @@map("admin_permissions")
}

model AdminRolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime @default(now())

  role         AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("admin_role_permissions")
}

model AdminSession {
  id               String    @id @default(cuid())
  adminId          String
  device           String?
  browser          String?
  os               String?
  ip               String?
  country          String?
  refreshTokenHash String    @unique
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  lastSeenAt       DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  admin            AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_sessions")
}

model AdminAuditLog {
  id        String     @id @default(cuid())
  adminId   String?
  action    String
  resource  String
  entityId  String?
  ip        String?
  browser   String?
  metadata  Json?
  createdAt DateTime   @default(now())

  admin     AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([action])
  @@map("admin_audit_logs")
}

