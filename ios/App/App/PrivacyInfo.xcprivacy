<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PrivacyInfo.xcprivacy — Apple Privacy Manifest

  Required for App Store submission as of Spring 2024.
  Declares the app's use of required reason APIs and tracking status.

  See: https://developer.apple.com/documentation/bundleresources/privacy_manifest_files
-->
<plist version="1.0">
<dict>
	<!-- The app does NOT track users across apps/websites -->
	<key>NSPrivacyTracking</key>
	<false/>

	<!-- No tracking domains -->
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- Required Reason API declarations -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!--
		  UserDefaults (NSUserDefaults)
		  Reason: CA92.1 — Access info from same app or app group
		  Used by: Capacitor Preferences plugin, Zustand persist middleware
		-->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>

		<!--
		  File timestamp APIs (stat, fstat, etc.)
		  Reason: C617.1 — Access file timestamps within the app container
		  Used by: Capacitor file operations, offline cache
		-->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>

		<!--
		  Disk space APIs (statfs, statvfs, etc.)
		  Reason: E174.1 — Check disk space to prevent write failures
		  Used by: Capacitor asset storage, offline cache writes
		-->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
			</array>
		</dict>

		<!--
		  System boot time APIs (systemUptime, mach_absolute_time)
		  Reason: 35F9.1 — Measure elapsed time within the app
		  Used by: Performance monitoring, animation timing
		-->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
	</array>

	<!-- No collected data types beyond what is declared above -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
</dict>
</plist>
