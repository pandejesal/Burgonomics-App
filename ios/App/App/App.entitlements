<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links: must match public/.well-known/apple-app-site-association
	     (appIDs GLASSDOORS.com.glassdoorsstudio.burgonomics). Without this
	     entitlement, https links open in Safari instead of the app. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:burgonomics.com</string>
		<string>applinks:www.burgonomics.com</string>
		<string>applinks:burgonomics.netlify.app</string>
	</array>
</dict>
</plist>
