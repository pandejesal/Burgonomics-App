<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<!-- Associated domains. Mirrors the Android manifest android:autoVerify
	     intent-filter hosts (burgonomics.com, www.burgonomics.com,
	     burgonomics.netlify.app) and the project Firebase host so HTTPS links open
	     in the app on both platforms. Third-party domains are invalid for iOS. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:burgonomics.com</string>
		<string>applinks:www.burgonomics.com</string>
		<string>applinks:burgonomics.netlify.app</string>
		<string>applinks:burgonomics-7faa8.firebaseapp.com</string>
	</array>
</dict>
</plist>