// CANONICAL Firestore rules — the ROOT copy deployed to production by the
// root firebase.json (firestore config). The copies in
// burgonomics-foundation-core/firestore.rules (emulator target of the rules
// suite, scripts/test-rules.mjs) and burgonomics-partner/firestore.rules
// (reference mirror only — the partner app has no firebase.json deploy
// target) are byte-identical MIRRORS. NEVER edit a mirror: change this file,
// re-sync both mirrors, and re-run the rules suite (core:
// node scripts/test-rules.mjs).
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS (RBAC & Identity)
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getAdminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function brandRoles() {
      return ['brand_owner', 'developer'];
    }

    function staffRoles() {
      return ['brand_owner', 'developer', 'support', 'regional_manager', 'branch_owner', 'branch_staff'];
    }

    function hasRole(roles) {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && getAdminDoc().data.role in roles) ||
        (request.auth.token != null && (request.auth.token.role in roles))
      );
    }

    // B3-S1 (H-M4/C5): narrowed to BRAND roles only. Previously ANY
    // admins-doc holder (branch_staff/support/regional) passed isAdmin(),
    // leaking cross-branch chats, the payment ledger, and customer profiles.
    // Branch/support access now flows ONLY via isStaff()/ownsBranch() on
    // paths that explicitly grant it — never via isAdmin(). NOTE: a legacy
    // admins doc WITHOUT a role field no longer passes (fail-closed); the
    // claims setter mirrors role into the doc on every assignment.
    function isAdmin() {
      return hasRole(brandRoles());
    }

    // Non-brand operators (support/regional/branch). Usable ONLY where a
    // path explicitly grants operator access (e.g. branch announcements);
    // customer PII and money ledgers stay brand-only via isAdmin().
    function isStaff() {
      return hasRole(staffRoles());
    }

    function isBrandOwner() {
      return isAdmin();
    }

    function isBranchOwner() {
      return hasRole(['branch_owner', 'branch_staff']);
    }

    function ownsBranch(branchId) {
      return isBrandOwner() || (
        isBranchOwner() && (
          (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && getAdminDoc().data.branchId == branchId) ||
          (request.auth.token != null && branchId in request.auth.token.branchIds)
        )
      );
    }

    // Loop 12: delivery handover needs OTP proof — POST
    // /orders/verifyDeliveryOtp flips to DELIVERED server-side (lockout +
    // timing-safe compare). A direct client status write to DELIVERED on a
    // delivery order bypasses that proof. DEC-01 (Phase 3 T3.6-Roles) now
    // applies this to EVERY client role: brand_owner/developer lost the old
    // unpinned bypass, so delivery DELIVERED is server-only for everyone.
    // Takeaway/dine-in completion stays an in-person operator lane.
    // Missing/non-map status never matches (no block).
    function directDeliveredBypass() {
      return request.resource.data.status is map
        && request.resource.data.status.code == 'DELIVERED'
        && resource.data.orderType == 'delivery';
    }

    // -----------------------------------------------------------------------
    // DEC-01 (Phase 3, T3.6-ROLES) — SERVER-OWNED ORDER FIELD SET
    //
    // Policy (user decision 2026-10-25): the protected order fields —
    // basket/items, pricing/payments, dispatch state, POS sync, refunds and
    // the delivery-OTP proof — are written ONLY through validated Cloud
    // Functions (Admin SDK bypasses rules), for ALL client roles including
    // brand_owner/developer. The former `allow update: if isBrandOwner() ||…`
    // bypass is hereby removed; the brand roles now ride the SAME field mask
    // as branch staff. Writer audit before enforcement (both app sources):
    //   - core ordersService.ts: createOrder = one-time CREATE with items;
    //     setWhatsappOptIn = merge {whatsappOptIn, updatedAt}; cancelOrder =
    //     merge {status CANCELLED, completedAt}; markPaymentFailed and
    //     finalizePaidOrder are zero-write server-truth readers.
    //   - partner useOrders.ts updateOrderStatus = HTTP POST
    //     /orders/bumpStatus; adminOrdersService.ts is read-only
    //     (getDocs/onSnapshot).
    //   - partner walk-in lane = one-time CREATE with items
    //     (ManualOrderCreateModal.tsx via createOrderDocIfAbsent).
    // No legitimate post-create client write to a protected field remains.
    //
    // =======================================================================
    // REVIEWER RED 2026-10-27 (rules review = REVISE): ALLOWLIST INVERSION.
    // The former mechanism here was a DENYLIST (orderServerOwnedUpdateKeys)
    // plus map-value equality locks, and it was reproduced-bypassable two
    // ways: (1) every server-owned lease/claim family discovered after the
    // list was written was MISSING from it — refundActiveClaim/refundClaimed*
    // /refundLedger/refundedTotalPaise/refundKeyedReceipts (razorpay.service
    // claimRace), dispatchClaimedAt/porterDispatchClaimedAt/
    // dispatchPendingCorrelation/dispatchReleasedBindings/porterDispatchStatus
    // (F10 second-rider guard), petpoojaClaimedAt/petpoojaPushClaimedAt and
    // routeTransferClaimedAt — a staff/brand write could forge a refund
    // already-refunded/in-progress or freeze/mint dispatches; and (2) a
    // LITERAL dotted key ("payment.razorpayPaymentId" as one top-level
    // field, escaped-dot updateDoc path) changed no MAP value, so the
    // map-equality locks never fired, while the backend
    // readRecordedPaymentField (razorpay.service.ts ~122-132) reads that
    // legacy literal as authoritative. Per review directive the update lane
    // is INVERTED: only an explicit allowlist of workflow keys is ever
    // writable, so every protected family — known today or discovered later —
    // is denied by construction. An allowlist of dot-free literals also
    // rejects every literal-dotted or dotted PATH write: diff().affectedKeys()
    // reports those as dotted strings ('payment.razorpayPaymentId',
    // 'payment.status'), and dotted strings are members of no allowlist
    // entry, so no separate '.contains' check is possible/needed — the
    // exact-subset test IS the dot rejection.
    // =======================================================================
    function orderUpdateAllowedKeys() {
      return [
        'status',        // masked workflow status (bumpStatus-era lane; DELIVERED
                         // on delivery orders stays OTP-only via
                         // directDeliveredBypass() above)
        'completedAt',   // completion timestamp paired with the bump
        'updatedAt',     // writer stamp
        'statusHistory', // append-only timeline (see guard below)
        'cancellationReason' // cancellation note paired with the bump
      ];
    }

    // statusHistory may only GROW: a client rewrite that erases or shrinks
    // history (same-size content rewrites remain possible and are accepted —
    // a fuller element-level diff is not worth the complexity for a lane no
    // audited client writer uses) is the one erase-abuse a plain allowlist
    // would still admit.
    function orderStatusHistoryAppendOnly() {
      return request.resource.data.get('statusHistory', []) is list
        && resource.data.get('statusHistory', []) is list
        && request.resource.data.get('statusHistory', []).size()
          >= resource.data.get('statusHistory', []).size();
    }

    // Operator workflow lane for /orders updates — global brand roles or
    // branch-scoped staff, the DEC-01 allowlist (orderUpdateAllowedKeys +
    // orderStatusHistoryAppendOnly above), and the Loop-12 OTP handover proof
    // (never a direct DELIVERED on a delivery order). Extracted as a named
    // helper because the rules evaluator rejects the equivalent inlined
    // `X && ((a) || (b) || (c))` grouping.
    //
    // hasOnly is the exact-subset test in THE ONE direction that matters:
    // every affected key must be a member of the dot-free workflow literals.
    // That subsumes the reviewer's "reject keys containing a dot" — affects
    // report literal-dotted keys ("payment.razorpayPaymentId") and dotted
    // PATH writes ("payment.status", "items.0.quantity") as dotted strings,
    // which match no allowlist entry. A dot-free no-op (empty affected set)
    // is vacuously accepted. (This emulator's rules compiler rejects
    // Set.toList(), so no explicit string `.contains('.')` scan is possible;
    // the subset test is the dot rejection.)
    function orderOperatorUpdateLane() {
      return (isBrandOwner() || (isBranchOwner() && ownsBranch(resource.data.branchId)))
        && !directDeliveredBypass()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          orderUpdateAllowedKeys()
        )
        && orderStatusHistoryAppendOnly();
    }

    // Orders CREATE (both lanes): the canonical initial status meta only.
    // Core ordersService.createOrder writes resolveStatus('PLACED') =
    // {code:'PLACED',label,kind:'upcoming',terminal:false}; partner
    // ManualOrderCreateModal writes toDeliveryStatusMeta('pending') =
    // the same {code:'PLACED',…} shape (utils/orderContract.ts PARTNER_TO_DELIVERY).
    // Planted terminal/in-flight statuses at birth are denied.
    function orderCreateInitialStatus() {
      return request.resource.data.status is map
        && request.resource.data.status.code == 'PLACED'
        && request.resource.data.status.terminal != true
        && request.resource.data.status.keys().hasOnly(['code', 'label', 'kind', 'terminal']);
    }

    // =======================================================================
    // REVIEWER RED 2026-10-27 (rules review = REVISE): CREATE ALLOWLIST.
    // (orderCreateInitialStatus above stays the birth-status contract.)
    // The old create rule was a key DENYLIST (orderCreateForbiddenKeys);
    // every server-owned lease/claim family discovered after it was written
    // (refundActiveClaim/refundClaimed*/refundLedger/refundedTotalPaise/
    // refundKeyedReceipts, dispatchClaimedAt/porterDispatchClaimedAt/
    // dispatchPendingCorrelation/dispatchReleasedBindings/porterDispatchStatus,
    // petpoojaClaimedAt/petpoojaPushClaimedAt, routeTransferClaimedAt) was
    // absent, and a LITERAL dotted key ("payment.razorpayPaymentId" as one
    // top-level field) bypassed the payment-map allowlist because 'payment'
    // itself stayed absent while the backend's readRecordedPaymentField
    // treats the legacy dotted literal as authoritative. Both create lanes
    // are INVERTED to an ALLOWLIST of exactly the keys the writer audits
    // observed the two real creators planting (core ordersService.createOrder
    // and partner walkInOrder/ManualOrderCreateModal): everything else —
    // forged lease state, planted refund claims, or any literal-dotted
    // binding — is refused by construction, for every current and future
    // server-owned field. (Known integration dependency, unchanged by this
    // revision: partner still stamps petpoojaSyncStatus:`pending` in
    // ManualOrderCreateModal.tsx; that key is POS-sync-owned and stays
    // forbidden, so the legacy walk-in payload stays denied until the
    // partner owner's pending field removal merges.)
    // =======================================================================
    function orderCreateAllowedKeys() {
      return [
        // Identity + placement (both lanes).
        'id', 'shortCode', 'orderId', 'customerId', 'userId', 'branchId', 'branchName', 'city',
        'branchCoordinates', 'orderType', 'fulfillment', 'tableNumber',
        'customerName', 'customerPhone',
        // Basket and client-authored pricing snapshot (repriced server-side at
        // payment verification; cash-lane totals are a documented residual).
        'items', 'subtotal', 'tax', 'deliveryFee', 'total', 'totals', 'tipAmount',
        'promo', 'loyaltyPointsRedeemed', 'checkoutFingerprint',
        // Delivery context, notes and fulfilment instructions.
        'store', 'address', 'deliveryAddress', 'notes', 'specialInstructions',
        'fulfillmentInstructions',
        // Workflow meta.
        'status', 'payment', 'paymentMethod', 'paymentStatus', 'whatsappOptIn',
        'placedAt', 'estimatedAt', 'createdAt', 'updatedAt',
        // Best-effort POS push failure surface (display only — POS STATE —
        // petpoojaStatus/AcceptedNoId/SyncStatus/OrderId — stays server-owned).
        'petpoojaError'
      ];
    }

    // Allowlist over the written top-level keys ONLY (plus the nested-map
    // allowlists beneath them). A literal field name containing a dot
    // ("payment.razorpayPaymentId") is a member of no entry here, so
    // planted legacy bindings are refused; nested injections under allowed
    // maps (e.g. inside `payment`) are refused by that map's own hasOnly
    // allowlist in orderCreatePaymentClientFieldsOnly().
    function orderCreateKeysAllowlisted() {
      return orderCreateAllowedKeys().hasAll(request.resource.data.keys());
    }

    // Nested payment display marker at birth. The customer lane is
    // pending-only: a client cannot mint a paid/completed settlement marker.
    // The walk-in lane may be born completed because cash is tendered at the
    // counter. Absent payment is fine (older clients/walk-in writes).
    //
    // ALLOWLIST the map itself, both lanes: `payment.routeTransfer` (the Route
    // receipt) and the capture/refund bookkeeping are server-written after
    // gateway verification. executeRouteSplit's fast path treats ANY stored
    // `payment.routeTransfer` as an already-executed payout and returns
    // "done" without POSTing the transfer (razorpay.service.ts), so a
    // client-planted receipt at order create silently suppresses the branch
    // settlement. Only the display fields the apps write are allowed.
    function orderCreatePaymentClientFieldsOnly() {
      return !('payment' in request.resource.data) || (
        request.resource.data.payment is map &&
        request.resource.data.payment.keys().hasOnly([
          'method', 'label', 'status', 'transactionId', 'paidAt'
        ])
      );
    }
    function orderCreatePaymentPendingOnly() {
      return orderCreatePaymentClientFieldsOnly() && (
        !('payment' in request.resource.data) || (
          request.resource.data.payment is map &&
          (
            !('status' in request.resource.data.payment) ||
            request.resource.data.payment.status in ['pending', 'Pending', 'PENDING', 'CASH_PENDING', 'PAY_AT_STORE']
          )
        )
      );
    }
    function orderCreatePaymentSettledWalkin() {
      return orderCreatePaymentClientFieldsOnly() && (
        !('payment' in request.resource.data) || (
          request.resource.data.payment is map &&
          (
            !('status' in request.resource.data.payment) ||
            request.resource.data.payment.status in ['pending', 'Pending', 'PENDING', 'CASH_PENDING', 'PAY_AT_STORE', 'completed']
          )
        )
      );
    }

    // =========================================================================
    // CRM: CUSTOMERS & GLOBAL LOYALTY (Brand-wide)
    // =========================================================================

    match /customers/{customerId} {
      allow read: if isUser(customerId) || isAdmin();
      // Escalation denylist aligned with users/{userId} (below). Grep of
      // both app sources found NO client writer to customers/* (core
      // loyaltyStore.ts:79 only reads; partner useCustomers/useCustomer only
      // read; grill-coin adjustments go through server functions), so
      // blocking claim-like/PII/projection fields at birth breaks no flow —
      // server writes bypass rules via the Admin SDK.
      allow create: if isUser(customerId)
        && !request.resource.data.keys().hasAny([
          'loyaltyPoints', 'grillCoins', 'role', 'isStaff', 'isBrandOwner',
          'isBrandAdmin', 'isSuperAdmin', 'isAdmin', 'isOwner',
          'phone', 'email', 'createdAt'
        ]);
      allow update: if (isUser(customerId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'loyaltyPoints', 'grillCoins', 'role', 'isStaff', 'isBrandOwner',
        'isBrandAdmin', 'isSuperAdmin', 'isAdmin', 'isOwner',
        'phone', 'email', 'createdAt'
      ])) || isBrandOwner();
      allow delete: if false;

      match /addresses/{addressId} {
        allow read: if isUser(customerId) || isAdmin();
        allow write: if isUser(customerId);
      }
    }

    // Lane 07: users/{uid}.fcmTokens is the push fan-out list that
    // fcmClient.ts/dispatch actually reads. It is REMOVAL-ONLY for EVERY
    // client role (owner and brand alike): the only writers allowed to ADD a
    // token are the Admin SDK seams registerToken
    // (core/deviceTokenRegister.ts) and unregisterToken
    // (modules/notifications/unregisterToken.ts), which prove device_tokens
    // ownership and refuse foreign/ownerless bindings. A client-side append
    // would re-create exactly the foreign-token adoption those seams reject
    // (HTTP 409) through the SDK instead, so a client can never introduce a
    // token value that is not already stored on that same doc: the list may
    // only shrink (or repeat stored values within the stored size bound).
    // Legit client write: notificationsService.unlinkUserFromDeviceToken
    // fallback -> fcmTokens: arrayRemove(token) on the caller's OWN doc.
    function fcmTokensRemovalOnly() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['fcmTokens'])
        || (
          request.resource.data.get('fcmTokens', []) is list
          && resource.data.get('fcmTokens', []) is list
          && request.resource.data.get('fcmTokens', []).hasOnly(resource.data.get('fcmTokens', []))
          // hasOnly is a subset test that ignores multiplicity, so the explicit
          // size bound is what stops duplicate-inflation of the fan-out list.
          && request.resource.data.get('fcmTokens', []).size() <= resource.data.get('fcmTokens', []).size()
        );
    }

    match /users/{userId} {
      allow read: if isUser(userId) || isAdmin();
      allow create: if isUser(userId)
        && !request.resource.data.keys().hasAny(['role', 'isStaff', 'isBrandAdmin', 'isSuperAdmin', 'grillCoins', 'loyaltyPoints'])
        // First token link is server-stamped by POST /notifications/registerToken.
        && !request.resource.data.keys().hasAny(['fcmTokens']);
      // Brand/operator authority is bounded by the SAME fan-out invariant:
      // attaching a token is server-only for every role, so no client path
      // (owner or brand) can re-create a foreign-token binding the
      // registerToken gate refuses. Role/tenant fields stay brand-writable.
      allow update: if (isBrandOwner() && fcmTokensRemovalOnly()) || (
        isUser(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isStaff', 'isBrandAdmin', 'isSuperAdmin', 'grillCoins', 'loyaltyPoints'])
        && fcmTokensRemovalOnly()
      );
      allow delete: if false;

      match /addresses/{addressId} {
        allow read: if isUser(userId) || isAdmin();
        allow write: if isUser(userId);
      }

      match /notifications/{notifId} {
        allow read: if isUser(userId) || isAdmin();
        allow create: if false; // server-only via Admin SDK (fcm.service.ts)
        // B3-S1 field mask: read-receipts only; server owns body/priority.
        allow update: if isUser(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt', 'updatedAt']);
        allow delete: if isUser(userId);
      }

      // Shadow-order subcollection: grep of both app sources + functions/
      // found NO client or function writer/reader of users/{uid}/orders
      // (only users/{uid}/notifications is used client-side). Writes are
      // therefore server-only (Admin SDK bypasses rules); the identity-only
      // create here was an unused privilege.
      match /orders/{orderId} {
        allow read: if isUser(userId) || isAdmin();
        allow create, update, delete: if false;
      }
    }

    // =========================================================================
    // SALES: ORDERS (Branch-scoped, customer own-only)
    // =========================================================================

    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        ownsBranch(resource.data.branchId)
      );

      // Loop-hardening: the old identity-only create (`customerId == uid ||
      // userId == uid`) let any authenticated user birth an order with
      // arbitrary totals/paymentStatus/status — or stamp a VICTIM's id in
      // one identity field while owning the other. Two accepted shapes,
      // both verified against the live client payloads:
      //  1) Customer app (core ordersService.createOrder, src/features/
      //     orders/services/ordersService.ts:331-351) stamps BOTH customerId
      //     AND userId to request.auth.uid.
      //  2) Partner POS walk-in (partner ManualOrderCreateModal.tsx:144-181)
      //     stamps the literal 'cust_walkin' customerId; the POS lane stamps
      //     userId to the staff operator uid. Walk-in creates are gated to
      //     the operator's own outlet (isBranchOwner + ownsBranch) and never
      //     carry privileged server-owned keys at birth. Both lanes are
      //     pinned to the initial PLACED status shape; customer-lane
      //     paymentStatus stays pending-only (core writes no top-level
      //     paymentStatus at all — the paid state lives nested in
      //     `payment.status`, set after server-side gateway verification),
      //     while the walk-in lane may be born 'completed' (cash tendered at
      //     the counter) — 'failed' is never a birth state.
      allow create: if isAuthenticated() && (
        (
          request.resource.data.customerId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid &&
          orderCreateInitialStatus() &&
          orderCreateKeysAllowlisted() &&
          orderCreatePaymentPendingOnly() &&
          (
            !('paymentStatus' in request.resource.data) ||
            request.resource.data.paymentStatus in ['pending', 'Pending', 'PENDING', 'CASH_PENDING', 'PAY_AT_STORE']
          )
        ) || (
          request.resource.data.customerId == 'cust_walkin' &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.branchId is string &&
          request.resource.data.branchId.size() > 0 &&
          isBranchOwner() &&
          ownsBranch(request.resource.data.branchId) &&
          orderCreateInitialStatus() &&
          orderCreateKeysAllowlisted() &&
          orderCreatePaymentSettledWalkin() &&
          (
            !('paymentStatus' in request.resource.data) ||
            request.resource.data.paymentStatus in ['pending', 'completed']
          )
        )
      );

      allow update: if orderOperatorUpdateLane() || (
        // Customers may cancel their own pre-terminal orders only - canonical
        // cancelled literal-shape plus timestamps, nothing else. Terminal
        // orders are immutable to them. Key set pinned to statusMeta
        // (item86ingSync.ts:199-204): code/label/kind/terminal.
        isAuthenticated() &&
        (resource.data.customerId == request.auth.uid || resource.data.userId == request.auth.uid) &&
        !(resource.data.status.terminal == true) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt', 'updatedAt']) &&
        request.resource.data.status.code == 'CANCELLED' &&
        request.resource.data.status.kind == 'cancelled' &&
        request.resource.data.status.terminal == true &&
        request.resource.data.status.keys().hasOnly(['code', 'label', 'kind', 'terminal'])
      ) || (
        // Customer-owned notification preference: boolean opt-in only,
        // pinned to whatsappOptIn + updatedAt (order-confirmation toggle).
        isAuthenticated() &&
        (resource.data.customerId == request.auth.uid || resource.data.userId == request.auth.uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['whatsappOptIn', 'updatedAt']) &&
        request.resource.data.whatsappOptIn is bool
      );

      allow delete: if false;
    }

    // =========================================================================
    // BRANCHES & PRODUCTS CATALOG
    // =========================================================================

    match /branches/{branchId} {
      // Hardened: was `if true`. Grep evidence — the customer app NEVER
      // reads branches/* (its store directory is stores/*, separately
      // public); every branches reader is an authenticated partner hook
      // (useBranches/useTickets/useAnalytics/useBranchMenu). Anonymous
      // exposure of branch config (petpoojaStoreId, city/coords, hours) is
      // therefore closed. RESIDUAL RISK (recorded per audit): branch docs
      // carry Petpooja linkage fields — NEVER store secrets (API keys,
      // petpooja credentials/tokens, razorpay key secrets) on branches/*
      // docs; this rule makes them readable by ANY signed-in user.
      allow read: if isAuthenticated();
      allow create: if isBrandOwner();
      allow update: if isBrandOwner() || (
        ownsBranch(branchId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'razorpayAccountId', 'petpooja', 'petpoojaStoreId', 'servicedRadiusKm',
          'royaltyPercentage', 'packagingFee'
        ])
      );
      allow delete: if isBrandOwner();
    }

    // Canonical menu (both apps read; branch staff 86-ing writes).
    // Staff may only touch availability fields — never prices or identity.
    match /products/{productId} {
      allow read: if true;
      // Branch-owner create keeps price/name/description/category fields
      // writable: the partner combo builder legitimately creates products
      // client-side (useBranchMenu.createComboMeal, src/features/menu/
      // hooks/useBranchMenu.ts:259-282 — price/originalPrice/name/
      // description/categoryId/categoryName/branchId/restId are its payload).
      // What a branch operator may NOT plant at birth: margin data
      // (costPrice), discount-manipulation fields (compareAtPrice,
      // discountPercentage), or a fabricated petpoojaItemId — the combo
      // builder itself refuses to fabricate one because a fake id in the
      // shared id space could 86 an unrelated POS item (see its Loop-6
      // comment). Brand-owner creates are unrestricted (catalog imports).
      allow create: if isBrandOwner() || (
        isBranchOwner() && ownsBranch(request.resource.data.branchId) &&
        !request.resource.data.keys().hasAny([
          'costPrice', 'compareAtPrice', 'discountPercentage', 'petpoojaItemId'
        ])
      );
      allow update: if isBrandOwner() || (
        isBranchOwner() &&
        ownsBranch(resource.data.branchId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'price', 'costPrice', 'compareAtPrice', 'discountPercentage', 'name', 'description',
          'categoryId', 'categoryName', 'branchId', 'restId', 'petpoojaItemId', 'id'
        ])
      );
      allow delete: if isBrandOwner();
    }

    match /menu_items/{docId} {
      allow read: if true;
      allow write: if isBrandOwner();
    }

    // Per-branch synced menu (partner app: sync + availability toggles)
    match /menu/{branchId}/categories/{docId} {
      allow read: if true;
      allow create, update: if isBrandOwner() || ownsBranch(branchId);
      allow delete: if isBrandOwner();
    }

    match /menu/{branchId}/items/{itemId} {
      allow read: if true;
      allow create, update: if isBrandOwner() || ownsBranch(branchId);
      allow delete: if isBrandOwner();
    }

    match /stores/{storeId} {
      allow read: if true;
      allow write: if isBrandOwner();
    }

    // HOME MERCHANDISING — the customer app queries these anonymously at
    // boot (homeService getHome); without public read the home bundle is
    // always empty. Marketing content only; writes stay brand-owned.
    match /banners/{docId} {
      allow read: if true;
      allow write: if isBrandOwner();
    }

    match /categories/{docId} {
      allow read: if true;
      allow write: if isBrandOwner();
    }

    match /combos/{docId} {
      allow read: if true;
      allow write: if isBrandOwner();
    }

    match /offers/{docId} {
      allow read: if true;
      allow write: if isBrandOwner();
    }

    match /recommendations/{docId} {
      allow read: if true;
      allow write: if isBrandOwner();
    }

    match /admin_stores/{storeId} {
      allow read: if true;
      allow create: if isBrandOwner() || isBranchOwner();
      allow update: if isBrandOwner() || ownsBranch(storeId);
      allow delete: if isBrandOwner();
    }

    // Petpooja catalog — public read, server-side writes via Admin SDK
    match /petpooja_categories/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /petpooja_products/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /petpooja_offers/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /petpooja_sync_logs/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /petpooja_webhook_logs/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Branch launch announcements (partner useBranches broadcastLaunchAlert
    // addDoc — src/hooks/useBranches.ts:156-186). The companion call posts
    // /notifications/dispatch (partnerFunctionsApi.ts:809), and `upcoming_*`
    // topics are NOT in the server's subscribable allowlist
    // (notifications/topics.ts), so today the fan-out 403s for every role —
    // the doc write is the public-read audit record, and defacement/attribution
    // of that record is the risk this block bounds.
    // Writes are therefore: BRANCH-SCOPED (the doc carries a caller-stamped
    // branchId/targetTopic pair; an operator of branch_02 used to publish,
    // rewrite or delete for branch_01 — or aim targetTopic at another branch's
    // subscribers), TOPIC-BOUND (targetTopic == 'upcoming_' + branchId), and
    // SHAPE-BOUNDED to the exact payload the app sends (title/body caps mirror
    // BroadcastSchema). Global brand/support operators keep their shipped
    // all-branch write; regional_manager was city-clamped upstream, never
    // correct here (UI visibility change is lane 02's call — posted).
    // APPEND-ONLY: no client update/delete path exists in either app (partner
    // only addDoc'ed the record), so the record cannot be rewritten into
    // another branch (or at all) after creation; server moderation goes
    // through the Admin SDK.
    // RESIDUAL (accepted, no reader exists in either app today): branchName/
    // title/body text is caller-chosen, so a global writer could still mislabel
    // the displayed outlet name; binding it would cost one get() per write.
    function branchAnnouncementTopicBound() {
      return request.resource.data.branchId is string
        && request.resource.data.branchId.size() > 0
        && request.resource.data.targetTopic is string
        && request.resource.data.targetTopic == 'upcoming_' + request.resource.data.branchId;
    }

    function branchAnnouncementShape() {
      return request.resource.data.keys().hasOnly([
          'branchId', 'branchName', 'title', 'body', 'targetTopic', 'createdAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 1000;
    }

    function globalAnnouncementWriter() {
      return hasRole(['brand_owner', 'developer', 'support']);
    }

    match /branch_announcements/{docId} {
      allow read: if true;
      allow create: if (globalAnnouncementWriter() || ownsBranch(request.resource.data.branchId))
        && branchAnnouncementTopicBound()
        && branchAnnouncementShape();
      allow update, delete: if false;
    }

    // =========================================================================
    // SUPPORT TICKETING (support_tickets & tickets)
    // =========================================================================

    // B3-S1 (H-M17/H13): owner direct UPDATE is blocked — status/priority/
    // assignedTo/resolution are staff-only and the tickets.service.ts
    // transitions own every mutation via Admin SDK. Owner writes flow through
    // POST /tickets/* (functions), never through a client update that could
    // escalate/resolve its own ticket.
    // Ticket outcomes are server-owned. At root commit 0cca973, the note
    // route writes a string resolution plus terminal status; money actions
    // write a resolution map including couponCode/refundResult/resolvedBy.
    // The server's already-resolved check depends on status, not that map.
    // Both roles and collections share this mask: no field erasure, tenant
    // re-stamping, terminal-status spoofing, or money-map replacement.
    // Once resolved/closed, clients cannot reopen, rewrite resolution, or
    // reassign. Only timeline/updatedAt remain writable for the existing
    // reply fallback. This field mask does NOT enforce append-only history.
    // The allowlist also denies resolutionClaim as defence in depth; a
    // resolution lease is not present in that committed backend revision.
    function ticketWorkflowUpdateOnly() {
      return !request.resource.data.diff(resource.data).removedKeys().hasAny([
          'status', 'resolution', 'assignedTo', 'timeline', 'lastActivityAt', 'updatedAt'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'resolution', 'assignedTo', 'timeline', 'lastActivityAt', 'updatedAt'
        ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
          || (request.resource.data.status is string
              && ['open', 'in_progress', 'escalated'].hasAny([request.resource.data.status]))
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['resolution'])
          || (resource.data.get('resolution', '') is string
              && request.resource.data.resolution is string)
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['assignedTo'])
          || (request.resource.data.assignedTo is map
              && 'tier' in request.resource.data.assignedTo
              && request.resource.data.assignedTo.keys().hasOnly(['tier'])
              && ['branch', 'brand_support', 'developer_team'].hasAny([request.resource.data.assignedTo.tier]))
        )
        && (
          !(resource.data.get('status', '') == 'resolved'
            || resource.data.get('status', '') == 'closed')
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['timeline', 'updatedAt'])
        );
    }

    match /support_tickets/{ticketId} {
      allow read: if isBrandOwner() || (
        isBranchOwner() && ownsBranch(resource.data.branchId)
      ) || (
        isAuthenticated() && resource.data.customerId == request.auth.uid
      );
      // Loop 7: create allowlist — a client must not self-set status/
      // resolution/priority/assignedTo or money-action fields (resolutionAction,
      // refundAmount, refundResult, couponCode, amount) at birth; those are
      // server-owned via POST /tickets/* (functions), never through a client
      // write that could escalate/resolve its own ticket.
      // Hardening: 'priority' and 'assignedTo' removed from the allowlist —
      // grep found NO client create path (partner useTickets.createTicket
      // goes through POST /tickets/create via partnerFunctionsApi; the core
      // app never writes tickets), so the fields are server-stamped only.
      allow create: if isAuthenticated()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.branchId is string
        && request.resource.data.branchId.size() > 0
        && request.resource.data.keys().hasOnly([
          'ticketNumber', 'subject', 'description', 'message', 'title',
          'category', 'type', 'branchId', 'orderId', 'customerId', 'customerName',
          'customerPhone', 'status', 'targetTier',
          'branchReminderSent', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.status == 'open';
      // Loop 7: staff update field mask — direct client writes may advance
      // workflow (status/resolution/assignedTo/timeline) but money-action and
      // identity fields resolve server-side only (POST /tickets/resolve).
      // Brand authority now shares the exact same workflow as branch staff —
      // one helper, two arms; only the mask can differ, and it cannot.
      allow update: if (isBrandOwner() && ticketWorkflowUpdateOnly()) || (
        isBranchOwner() && ownsBranch(resource.data.branchId) &&
        ticketWorkflowUpdateOnly()
      );
      allow delete: if false;
    }

    match /tickets/{ticketId} {
      allow read: if isBrandOwner() || (
        isBranchOwner() && ownsBranch(resource.data.branchId)
      ) || (
        isAuthenticated() && resource.data.customerId == request.auth.uid
      );
      // Loop 7: same create allowlist + staff update mask as support_tickets
      // (legacy collection, same threat model). 'priority'/'assignedTo' are
      // server-stamped only (POST /tickets/create) — see support_tickets note.
      allow create: if isAuthenticated()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.branchId is string
        && request.resource.data.branchId.size() > 0
        && request.resource.data.keys().hasOnly([
          'ticketNumber', 'subject', 'description', 'message', 'title',
          'category', 'type', 'branchId', 'orderId', 'customerId', 'customerName',
          'customerPhone', 'status', 'targetTier',
          'branchReminderSent', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.status == 'open';
      // Same helper, legacy mirror — the masks are mechanically identical.
      allow update: if (isBrandOwner() && ticketWorkflowUpdateOnly()) || (
        isBranchOwner() && ownsBranch(resource.data.branchId) &&
        ticketWorkflowUpdateOnly()
      );
      allow delete: if false;
    }

    // =========================================================================
    // PAYMENT AUDIT TRAIL & DEVELOPER ERROR SNAPSHOTS (Append-only / Admin read)
    // =========================================================================

    // Server-only append collections — Admin SDK bypasses rules; block all client direct writes
    match /payment_audits/{auditId} {
      allow read: if isBrandOwner();
      allow create, update, delete: if false;
    }

    match /paymentAudits/{auditId} {
      allow read: if isBrandOwner();
      allow create, update, delete: if false;
    }

    // Razorpay webhook unmatched parking (webhookHandler.ts) — server-only
    match /unmatched_payments/{docId} {
      allow read: if isBrandOwner();
      allow create, update, delete: if false;
    }

    // Petpooja 86-ing sync unmatched parking (item86ingSync.ts) — server-only
    match /unmatched_petpooja_orders/{docId} {
      allow read: if isBrandOwner();
      allow create, update, delete: if false;
    }

    // Porter webhook unmatched parking (porter.service.ts) — server-only
    match /unmatched_porter_events/{docId} {
      allow read: if isBrandOwner();
      allow create, update, delete: if false;
    }

    // Route transfer event log (webhookHandler.ts) — server-only
    match /route_transfer_events/{docId} {
      allow read: if isBrandOwner();
      allow create, update, delete: if false;
    }

    // Refund request identity receipts (razorpay.service.ts autoRefund) —
    // server-only. Denied explicitly rather than left to the default-deny
    // fallback: the document id is a hash of order/payment/request ids and
    // carries money state, so no client lane may read or write it.
    // Allows are additive: review any future overlapping wildcard rules too.
    match /payment_refund_requests/{docId} {
      allow read, write: if false;
    }

    // Dispatch pending-bind correlation tokens (dispatch.router.ts claim tx)
    // — server-only. Keep correlation metadata out of client reads/writes;
    // callbacks must still pass the provider authentication and binding checks.
    match /dispatch_correlation_map/{docId} {
      allow read, write: if false;
    }

    match /dev_error_snapshots/{snapshotId} {
      allow read: if isBrandOwner();
      allow create, update, delete: if false;
    }

    // Payment ledger — partner admin app reads payments and manages refunds/discrepancies
    match /payments/{docId} {
      allow read: if isBrandOwner();
      allow create, update, delete: if false; // server-only via Admin SDK
    }

    match /refunds/{refundId} {
      allow read: if isBrandOwner();
      allow create: if false; // server-only via Admin SDK
      allow update: if false; // server-only via Admin SDK
      allow delete: if false;
    }

    match /payment_discrepancies/{docId} {
      allow read: if isBrandOwner();
      allow create: if false; // server-only via Admin SDK
      allow update: if false; // server-only via Admin SDK
      allow delete: if false;
    }

    // =========================================================================
    // CHATS & DIRECT MESSAGING
    // =========================================================================

    // Chat thread metadata — participants may read/update their own threads
    match /chats/{chatId} {
      allow read: if isBrandOwner() || (
        isAuthenticated() && request.auth.uid in resource.data.participantIds
      );
      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.participantIds;
      // Field mask (audit): thread metadata is NOT freely updatable —
      // participantIds/participantNames (membership) and identity fields
      // may not be REWRITTEN by a participant. The only legit client update
      // is the reply metadata written by partner chatService.sendMessage
      // (src/services/chatService.ts:156-160). The ensure-thread merge
      // (chatService.ts:139-154 / useChats.ts:87-96) writes membership fields
      // back with values read from the SAME doc, so they are unchanged and
      // do not appear in diff().affectedKeys(); only an actual membership
      // rewrite trips the mask. getOrCreateBranchChannel's background
      // membership refresh on an EXISTING channel is denied and degrades
      // gracefully (useChats.ts:104-109 catches and warns; the channel
      // still opens).
      allow update: if isBrandOwner() || (
        isAuthenticated() && request.auth.uid in resource.data.participantIds &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessageText', 'lastMessageSender', 'lastMessageAt', 'updatedAt'
        ])
      );
      allow delete: if false;
    }

    // Message reads are participant- or brand-scoped — the old admin-only
    // rule let ANY branch staffer (all admins) read EVERY branch's chats.
    // Writers must stamp participantIds on the parent thread doc.
    function chatParticipantIds(pairId) {
      return get(/databases/$(database)/documents/chats/$(pairId)).data.get('participantIds', []);
    }

    match /chats/{pairId}/messages/{messageId} {
      allow read: if isBrandOwner() || (
        isAuthenticated() && request.auth.uid in chatParticipantIds(pairId)
      );
      allow create: if isBrandOwner() || (
        isAuthenticated() && request.auth.uid in chatParticipantIds(pairId)
      );
      allow update, delete: if false;
    }

    // =========================================================================
    // ADMINS & APP SETTINGS
    // =========================================================================

    match /admins/{uid} {
      allow read: if isUser(uid) || isBrandOwner();
      allow write: if isBrandOwner();
    }

    // Admin session tracking + session listing.
    // B3-S1 (H-R20): sessions are SERVER-minted only (Admin SDK bypasses
    // rules). Client self-mint let any authenticated user fabricate a staff
    // session doc. Partner adminAuthService's client-side session write must
    // move to a server mint (queued to batch 4Z/5); reads are unaffected.
    match /admins/{uid}/sessions/{sessionId} {
      allow read: if isUser(uid) || isBrandOwner();
      allow create, update, delete: if false;
    }

    // Top-level notifications (partner useNotifications reads/updates own by userId)
    // B3-S1 (batch-1 queued field mask): owner updates are read-receipts
    // ONLY — body/userId/priority rewrites are server-owned via dispatchFCM.
    match /notifications/{notifId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if false; // server-only (no direct-client writer)
      allow update: if isBrandOwner() || (
        isAuthenticated() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt', 'updatedAt'])
      );
      allow delete: if isBrandOwner();
    }

    match /app_settings/{docId} {
      allow read: if true;
      allow write: if isBrandOwner();
    }

    match /device_tokens/{token} {
      allow read: if false;
      allow create, update, delete: if false; // server-owned via registerToken (index.ts); kills any-auth overwrite
    }

    // =========================================================================
    // NOTIFICATION SERVER-OWNED PATHS (N09)
    // =========================================================================
    // Backend inventory (source-verified, functions/src):
    //   - modules/notifications/devicePrefs.ts reads/sets
    //     users/{uid}/device_prefs/{installationId} (Admin SDK).
    //   - modules/notifications/sendGate.ts writes notification_quarantine
    //     merge-rows on send-gate violations; its audit action
    //     "notification_admin_sends" lands in admin_audit_logs (above).
    //   - modules/tickets/supportNotifications.ts writes the attempt ledger
    //     notification_dispatch (Admin SDK).
    // These paths leak which device belongs to which account (and its
    // category toggles), forensic send state and raw provider receipt lanes:
    // NO client role — brand_owner/developer included — may read or write
    // them. All writes stay Admin SDK (bypasses rules).
    //
    // Firestore rules OR overlapping allows: these explicit `if false`
    // guards are reviewable tripwires, not hard walls. The real guarantee is
    // the ABSENCE of any overlapping allow statement — proved by the
    // emulator matrix in tests/rules/notification-server-only.rules.test.ts
    // (every role × read/list/create/update × own & foreign = DENIED).
    match /users/{prefOwnerUid}/device_prefs/{installationId} {
      allow read, write: if false;
    }

    match /notification_quarantine/{docId} {
      allow read, write: if false;
    }

    match /notification_dispatch/{docId} {
      allow read, write: if false;
    }

    // Dispatcher forensics — same server-only shape as payment_refund_requests
    // and dispatch_correlation_map (dispatch.router.ts / dispatch.webhooks.ts):
    // pending-bind maps, provider webhook event trails, unmatched parking.
    // Default-deny already; explicit for auditability.
    match /dispatch_order_map/{docId} {
      allow read, write: if false;
    }

    match /dispatch_webhook_events/{docId} {
      allow read, write: if false;
    }

    match /unmatched_dispatch_events/{docId} {
      allow read, write: if false;
    }

    // =========================================================================
    // FRANCHISE LEADS & COUPONS (India franchise pipeline + promo validation)
    // =========================================================================

    // B3-S1 (M14): franchise creates bind customerId==uid (no victim-id
    // stamping / spam-as-someone-else); updates keep the bind immutable.
    match /franchise_leads/{leadId} {
      allow read: if isBrandOwner() || isBranchOwner();
      allow create: if isAuthenticated()
        && request.resource.data.customerId == request.auth.uid;
      allow update: if isBrandOwner() || (
        isAuthenticated() && resource.data.customerId == request.auth.uid
        && request.resource.data.customerId == request.auth.uid
      );
      allow delete: if isBrandOwner();
    }

    // Partner app uses 'franchise_inquiries' (useFranchiseLeads) — mirror franchise_leads
    match /franchise_inquiries/{leadId} {
      allow read: if isBrandOwner() || isBranchOwner();
      allow create: if isAuthenticated()
        && request.resource.data.customerId == request.auth.uid;
      allow update: if isBrandOwner() || (
        isAuthenticated() && resource.data.customerId == request.auth.uid
        && request.resource.data.customerId == request.auth.uid
      );
      allow delete: if isBrandOwner();
    }

    match /coupons/{couponCode} {
      allow read: if true; // public coupon validation at checkout — unauth guest checkout needs read
      allow write: if isBrandOwner();
    }

    // Admin audit trail — immutable append-only
    match /admin_audit_logs/{logId} {
      allow read: if isBrandOwner();
      allow create, update, delete: if false; // server-only via Admin SDK
    }

    // Readiness-8: broadcast history written by POST /notifications/broadcast.
    // Brand-owner read (UI history source); client writes denied — rows are
    // server-measured sends, never client claims.
    match /broadcasts/{broadcastId} {
      allow read: if isBrandOwner();
      allow create, update, delete: if false; // server-only via Admin SDK
    }
  }
}
