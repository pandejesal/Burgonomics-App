rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Make sure to write security rules for your app before that time, or else
    // all client requests to your Firestore database will be denied until you Update
    // your rules
    
    // User profile: User can read and write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Petpooja Data: Anyone can read, only admin can write (we don't have admin role yet, so only read for now)
    match /petpooja_categories/{docId} {
      allow read: if true;
    }
    match /petpooja_products/{docId} {
      allow read: if true;
    }
    match /petpooja_offers/{docId} {
      allow read: if true;
    }
    match /petpooja_orders/{docId} {
      allow read, write: if true; // In production, restrict this to authenticated users or admin
    }
  }
}
