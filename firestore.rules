rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS (RBAC & Identity)
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getAdminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isBrandOwner() {
      return isAdmin() && getAdminDoc().data.role == 'brand_owner';
    }

    function isBranchOwner() {
      return isAdmin() && getAdminDoc().data.role == 'branch_owner';
    }

    function ownsBranch(branchId) {
      return isBrandOwner() || (isBranchOwner() && getAdminDoc().data.branchId == branchId);
    }

    function hasPermission(perm) {
      return isBrandOwner() || (
        isAdmin() &&
        'permissions' in getAdminDoc().data &&
        perm in getAdminDoc().data.permissions
      );
    }

    // Chat pair participant check: pairId format `${branchId}_${brandOwnerId}`
    // Allowed if caller is brand_owner OR branch_owner owning the branch
    function isChatParticipant(pairId) {
      return isBrandOwner() || (
        isBranchOwner() &&
        pairId.matches('^' + getAdminDoc().data.branchId + '_.*')
      );
    }

    // =========================================================================
    // CRM: CUSTOMERS & GLOBAL LOYALTY (Brand-wide)
    // =========================================================================

    match /customers/{customerId} {
      // Global loyalty points & profile: customer reads own doc; admins read for CRM
      allow read: if isUser(customerId) || isAdmin();
      allow create: if isUser(customerId)
        && (!('loyaltyPoints' in request.resource.data) || request.resource.data.loyaltyPoints == 0);
      allow update: if (isUser(customerId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['loyaltyPoints']))
        || isBrandOwner();
      allow delete: if false;

      match /addresses/{addressId} {
        allow read: if isUser(customerId) || isAdmin();
        allow write: if isUser(customerId);
      }
    }

    // Legacy users collection (sub-customer mapping)
    match /users/{userId} {
      allow read: if isUser(userId) || isAdmin();
      allow write: if isUser(userId);

      match /addresses/{addressId} {
        allow read: if isUser(userId) || isAdmin();
        allow write: if isUser(userId);
      }

      match /orders/{orderId} {
        allow read: if isUser(userId) || isAdmin();
        allow create: if isUser(userId);
        allow update, delete: if false;
      }
    }

    // =========================================================================
    // SALES: ORDERS (Branch-scoped, customer own-only)
    // =========================================================================

    match /orders/{orderId} {
      // Read: Customer reads own orders; Branch owner reads own branch; Brand owner reads all
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        ownsBranch(resource.data.branchId)
      );

      // Create: Authenticated customer creates own order with pending payment/pos status
      allow create: if isAuthenticated() && (
        request.resource.data.customerId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      ) && (
        !('paymentStatus' in request.resource.data) ||
        request.resource.data.paymentStatus in ['Pending', 'Payment_Pending', 'CASH_PENDING', 'PAY_AT_STORE', 'pending']
      ) && (
        !('payment' in request.resource.data) ||
        !('status' in request.resource.data.payment) ||
        request.resource.data.payment.status in ['pending', 'CASH_PENDING', 'PAY_AT_STORE']
      ) && (
        !('petpoojaStatus' in request.resource.data) ||
        request.resource.data.petpoojaStatus in ['Pending', 'Not_Synced', 'Bypassed']
      );

      // Update: Brand owner can update all; Branch owner can update status only (never totals or pricing)
      allow update: if isBrandOwner() || (
        isBranchOwner() &&
        ownsBranch(resource.data.branchId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['totals', 'pricingSnapshot', 'pricing', 'customerId', 'userId', 'branchId'])
      );

      allow delete: if false;
    }

    // =========================================================================
    // BRANCHES & UPCOMING OUTLETS
    // =========================================================================

    match /branches/{branchId} {
      // Public read for customer ordering and discovery
      allow read: if true;
      // Creation restricted strictly to Brand Owner (Branch Owner DENIED per Q10)
      allow create: if isBrandOwner() || hasPermission('manage_upcoming');
      // Update: Brand owner can edit all; Branch owner can update non-lifecycle fields of own branch
      allow update: if isBrandOwner() || hasPermission('manage_upcoming') || (
        ownsBranch(branchId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'expectedOpenDate'])
      );
      allow delete: if isBrandOwner();
    }

    // Legacy stores & admin_stores aliases
    match /stores/{storeId} {
      allow read: if true;
      allow write: if isBrandOwner();
    }

    match /admin_stores/{storeId} {
      allow read: if true;
      allow create: if isBrandOwner() || hasPermission('manage_upcoming');
      allow update: if isBrandOwner() || ownsBranch(storeId);
      allow delete: if isBrandOwner();
    }

    // Upcoming subscriptions ({uid}_{branchId})
    match /upcoming_subscriptions/{subId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.uid ||
        isBrandOwner()
      );
      allow create, update: if isAuthenticated() && request.auth.uid == request.resource.data.uid;
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    // =========================================================================
    // CHATS & DIRECT MESSAGING (1:1 Branch Owner <-> Brand Owner)
    // =========================================================================

    match /chats/{pairId}/messages/{messageId} {
      allow read: if isChatParticipant(pairId);
      allow create: if isChatParticipant(pairId) && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false; // Immutable chat history
    }

    // =========================================================================
    // TICKETS (Unified customer & branch tickets)
    // =========================================================================

    match /tickets/{ticketId} {
      allow read: if isBrandOwner() || (
        isBranchOwner() && ownsBranch(resource.data.branchId)
      ) || (
        isAuthenticated() && resource.data.customerId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.customerId == request.auth.uid ||
        (isBranchOwner() && ownsBranch(request.resource.data.branchId))
      );
      allow update: if isBrandOwner() || (
        isBranchOwner() && ownsBranch(resource.data.branchId)
      );
      allow delete: if false;
    }

    // =========================================================================
    // PAYMENT AUDIT TRAIL (Append-only)
    // =========================================================================

    match /paymentAudits/{auditId} {
      // Read: Brand owner reads all; Branch owner reads own branch
      allow read: if isBrandOwner() || (
        isBranchOwner() && ownsBranch(resource.data.branchId)
      );
      // Append-only: create allowed for authenticated callers / cloud functions
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // =========================================================================
    // ADMINS & PERMISSIONS
    // =========================================================================

    match /admins/{uid} {
      allow read: if isUser(uid) || isBrandOwner();
      allow write: if isBrandOwner();

      match /sessions/{sessionId} {
        allow read: if isUser(uid) || isBrandOwner();
        allow write: if false;
      }
    }

    // =========================================================================
    // SETTINGS, CATALOG & METADATA (Public read, Brand Owner write)
    // =========================================================================

    match /app_settings/{docId} {
      allow read: if true;
      allow write: if isBrandOwner();
    }

    match /menu_items/{docId} {
      allow read: if true;
      allow write: if isBrandOwner();
    }

    match /offers/{docId} {
      allow read: if true;
      allow write: if isBrandOwner();
    }

    match /coupons/{docId} {
      allow read: if true;
      allow write: if isBrandOwner();
    }

    match /petpooja_categories/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /petpooja_products/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /petpooja_offers/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Push notification device tokens
    match /device_tokens/{token} {
      allow read: if false;
      allow create, update: if isAuthenticated() && (
        !('userId' in request.resource.data) ||
        request.resource.data.userId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        resource == null ||
        !('userId' in resource.data) ||
        resource.data.userId == request.auth.uid
      );
    }

    // Internal integration & server-only collections
    match /petpooja_orders/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /payment_orders/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /payments/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /refunds/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /payment_discrepancies/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /webhook_events/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /petpooja_webhook_logs/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}