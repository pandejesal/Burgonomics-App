rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Admin UI moved to burgonomics-partner — rules retained
    // Helper function to identify admin users by checking the /admins/ collection
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Users: each user may only access their own document and subcollections.
    // Admins may read user documents for dashboard analytics (never write).
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;

      match /addresses/{addressId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      match /orders/{orderId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create: if request.auth != null
          && request.auth.uid == userId
          && (
            !('paymentStatus' in request.resource.data) ||
            request.resource.data.paymentStatus in ['Pending', 'Payment_Pending', 'CASH_PENDING', 'PAY_AT_STORE']
          )
          && (
            !('payment' in request.resource.data) ||
            !('status' in request.resource.data.payment) ||
            request.resource.data.payment.status in ['pending', 'CASH_PENDING', 'PAY_AT_STORE']
          )
          && (
            !('petpoojaStatus' in request.resource.data) ||
            request.resource.data.petpoojaStatus in ['Pending', 'Not_Synced', 'Bypassed']
          );
        allow update, delete: if false;
      }
    }

    // Top-level orders:
    // SEC-2 Lockdown: Clients can create orders ONLY with pending or cash payment statuses.
    // Paid status transitions can ONLY be performed by Admin SDK / Cloud Functions.
    match /orders/{orderId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && (
          !('paymentStatus' in request.resource.data) ||
          request.resource.data.paymentStatus in ['Pending', 'Payment_Pending', 'CASH_PENDING', 'PAY_AT_STORE']
        )
        && (
          !('payment' in request.resource.data) ||
          !('status' in request.resource.data.payment) ||
          request.resource.data.payment.status in ['pending', 'CASH_PENDING', 'PAY_AT_STORE']
        )
        && (
          !('petpoojaStatus' in request.resource.data) ||
          request.resource.data.petpoojaStatus in ['Pending', 'Not_Synced', 'Bypassed']
        );
      allow update, delete: if false;
    }

    // Stores catalog & configuration: Public read; Admin writes only — SEC-1 / SEC-4
    match /stores/{storeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Global application settings (pricing, feature flags): Public read; Admin write only — SEC-4
    match /app_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /petpooja_categories/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /petpooja_products/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /petpooja_offers/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Device tokens for native push notifications: Authenticated users only
    match /device_tokens/{token} {
      allow read: if false;
      allow create, update: if request.auth != null && (
        !('userId' in request.resource.data) ||
        request.resource.data.userId == request.auth.uid
      );
      allow delete: if request.auth != null && (
        resource == null ||
        !('userId' in resource.data) ||
        resource.data.userId == request.auth.uid
      );
    }

    // Integration bridge & payment authority docs: ONLY Cloud Functions (admin SDK) may write.
    // Admins may read for dashboard analytics/reconciliation.
    match /petpooja_orders/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /payment_orders/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /payments/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /refunds/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /payment_discrepancies/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Payment webhook audit trail (webhook-first reconciliation): admin read-only — SEC-7
    match /webhook_events/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Webhook logs: Admin read-only monitoring; client writes denied — SEC-7
    match /petpooja_webhook_logs/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Admin/internal store configurations: Public read for client checkout requirements; Admin write only — SEC-1
    match /admin_stores/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // Only Admin SDK/Cloud Functions can write
      match /sessions/{sessionId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }
  }
}