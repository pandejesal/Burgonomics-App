# ==============================================================================
# Burgonomics Customer App — Environment Configuration
# ==============================================================================
# Every key below is READ by src/core/config/env.ts (central config — feature
# code must never read import.meta.env directly). Keys are grouped by reader.
# Unset keys fall back to the defaults in env.ts — including placeholder API
# domains and embedded Firebase keys — so a clean-room setup MUST set the
# Firebase + API rows or it boots against the wrong project.

# --- App identity ---
VITE_APP_ENV=production
VITE_APP_NAME=Burgonomics
VITE_APP_VERSION=1.0.0

# --- Firebase (read as 7 SPLIT vars by src/core/config/firebase.ts — there is
# --- no VITE_FIREBASE_CONFIG JSON reader; do not use a single JSON blob) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=burgonomics-7faa8.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=burgonomics-7faa8
VITE_FIREBASE_STORAGE_BUCKET=burgonomics-7faa8.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Backend API ---
# Canonical base (alias VITE_API_URL also accepted). No fallback project here —
# unset builds point at burgonomics.example placeholders.
VITE_API_BASE_URL=https://asia-south1-burgonomics-7faa8.cloudfunctions.net/api
VITE_API_TIMEOUT_MS=15000
VITE_API_RETRY_ATTEMPTS=2
VITE_API_RETRY_BACKOFF_MS=400

# --- Feature flags (VITE_FF_*) ---
VITE_FF_OFFLINE_MODE=true
VITE_FF_ORDER_TRACKING=true
VITE_FF_REFERRALS=false
VITE_FF_ADMIN_OPS=false

# --- Analytics ---
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_WRITE_KEY=""

# --- Push (canonical VITE_PUSH_* names — appConfig.push reads ONLY these;
# --- FCM_ENABLED / VITE_FCM_VAPID_KEY do NOT enable push) ---
VITE_PUSH_ENABLED=false
VITE_PUSH_VAPID_PUBLIC_KEY=""

# --- Integrations ---
VITE_RAZORPAY_KEY_ID=rzp_live_...
# (alias VITE_RAZORPAY_KEY also accepted; production refuses rzp_test_* keys)
VITE_PAYMENTS_API_BASE_URL=/.netlify/functions/payments
VITE_MAPS_API_KEY=
# (alias VITE_MAPS_KEY also accepted)
VITE_PETPOOJA_ENABLED=false
# Optional override for the Cloud Functions base (canonical; PROXY_URL alias below).
# Default: https://asia-south1-<VITE_FIREBASE_PROJECT_ID>.cloudfunctions.net/api
VITE_FUNCTIONS_API_URL=https://asia-south1-burgonomics-7faa8.cloudfunctions.net/api
# VITE_PETPOOJA_PROXY_URL=https://asia-south1-burgonomics-7faa8.cloudfunctions.net/api

# --- App Check (reCAPTCHA v3 site key). Server enforces only with
# --- APP_CHECK_ENFORCEMENT=true in functions env (monitor mode by default).
VITE_RECAPTCHA_SITE_KEY=""

# ==============================================================================
# SERVER / SHARED BACKEND KEYS (reference only — set in functions/.env or the
# hosting dashboard, NEVER in this client file)
# ==============================================================================
# RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET / RAZORPAY_WEBHOOK_SECRET
# OTP_HMAC_SECRET (set before rotating the webhook secret)
# PETPOOJA_APP_KEY / PETPOOJA_APP_SECRET / PETPOOJA_ACCESS_TOKEN
# PORTER_API_KEY / PORTER_CUSTOMER_ID / PORTER_WEBHOOK_SECRET
# FIREBASE_PROJECT_ID / FIREBASE_SERVICE_ACCOUNT (JSON)

# ==============================================================================
# GOING LIVE WITH PETPOOJA (only 3 steps — no code changes)
# 1. Paste the merchant key set from the Petpooja panel into functions/.env
#    (dotenv file — NOT functions:config, which the v2 runtime never reads).
# 2. Redeploy the Cloud Functions API with those variables set.
# 3. Set VITE_PETPOOJA_ENABLED=true above and redeploy this client.
# Without the flag (default) the app runs fully on the offline mock gateway.
# ==============================================================================

# Seeding & Admin RBAC
# Firestore admins collection seeding:
# admins/{yashUid}: { role: "brand_owner", name: "Yash", email: "yash@burgonomics.com" }
# admins/{branchOwnerUid}: { role: "branch_owner", branchId: "branch_01", name: "Branch Operator" }
