# ==============================================================================
# Burgonomics Environment Configuration
# ==============================================================================

# Client Runtime (Vite / Capacitor)
VITE_APP_ENV=production
VITE_FIREBASE_CONFIG='{"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}'
VITE_RAZORPAY_KEY_ID=rzp_live_...
VITE_PAYMENTS_API_BASE_URL=/.netlify/functions/payments
VITE_MAPS_KEY=

# Serverless Netlify Functions Environment
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...
FIREBASE_PROJECT_ID=burgonomics-7faa8
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"..."}'

# Petpooja POS API Integration (Toggle & Gateway Creds)
PETPOOJA_ENABLED=false
PETPOOJA_APP_KEY=""
PETPOOJA_APP_SECRET=""
PETPOOJA_ACCESS_TOKEN=""
PETPOOJA_REST_ID="" # Optional global fallback; canonical restID is stored per-branch in Firestore branches/{id}.petpooja.restId

# Client switch for the live Petpooja gateway (default: offline mock).
VITE_PETPOOJA_ENABLED=false
# Optional override for the Cloud Functions Petpooja proxy base.
# Default: https://asia-south1-<project>.cloudfunctions.net/api
# VITE_PETPOOJA_PROXY_URL=https://asia-south1-burgonomics-7faa8.cloudfunctions.net/api

# ==============================================================================
# GOING LIVE WITH PETPOOJA (only 3 steps — no code changes)
# 1. Paste the merchant key set from the Petpooja panel into the FUNCTIONS env
#    (hosting dashboard → Environment variables):
#      PETPOOJA_APP_KEY="..."
#      PETPOOJA_APP_SECRET="..."
#      PETPOOJA_ACCESS_TOKEN="..."
#    (Optional overrides: PETPOOJA_ORDERS_BASE, PETPOOJA_MENU_BASE.)
# 2. Redeploy the Cloud Functions API with those variables set. The client
#    calls POST /petpooja/pushOrder {orderId, order?}, /petpooja/syncMenu
#    {branchId, mode?}, /petpooja/health {} — the server injects the key set
#    and forwards to Petpooja (save_order / menu).
# 3. Set VITE_PETPOOJA_ENABLED=true above and redeploy this client.
# Without the flag (default) the app runs fully on the offline mock gateway.
# ==============================================================================

# Porter Production Delivery API Integration (Default Gated Stub)
# Note: features.porterEnabled is configured per-branch in Firestore branches/{id}.features.porterEnabled
PORTER_API_KEY=""
PORTER_CUSTOMER_ID=""
PORTER_CITY="Ahmedabad"
PORTER_WEBHOOK_SECRET=""

# Firebase Cloud Messaging (web push: get key in Firebase Console → Project
# settings → Cloud Messaging → Web Push certificates → Generate key pair)
FCM_ENABLED=false
VITE_FCM_VAPID_KEY=""

# App Check (reCAPTCHA v3 site key from Google Cloud Console → Security →
# reCAPTCHA Enterprise → Create key → Website). Server enforces only with
# APP_CHECK_ENFORCEMENT=true in functions env (monitor mode by default).
VITE_RECAPTCHA_SITE_KEY=""

# Seeding & Admin RBAC
# Firestore admins collection seeding (Locked Q10 - 3 Brand Owners with equal full privileges):
# admins/{yashUid}: { role: "brand_owner", name: "Yash", email: "yash@burgonomics.com" }
# admins/{nehhUid}: { role: "brand_owner", name: "Nehh", email: "nehh@burgonomics.com" }
# admins/{devUid}:  { role: "brand_owner", name: "Antigravity Dev", email: "dev@burgonomics.com" }
# Branch Owners:
